script edit_graphic_create_image_menu 
	switch <category>
		case banners
		<title> = $wii_bandlogo_banners
		<title_pos> = (56.0, 0.0)
		if GlobalExists \{name = edit_graphics_banners
				type = array}
			<array_name> = $edit_graphics_banners
		else
			<array_name> = none
		endif
		case elemental
		<title> = $wii_bandlogo_elemental
		<title_pos> = (56.0, 0.0)
		if GlobalExists \{name = edit_graphics_elemental
				type = array}
			<array_name> = $edit_graphics_elemental
		else
			<array_name> = none
		endif
		case primitives
		<title> = $wii_bandlogo_shapes
		<title_pos> = (56.0, 0.0)
		if GlobalExists \{name = edit_graphics_primitives
				type = array}
			<array_name> = $edit_graphics_primitives
		else
			<array_name> = none
		endif
		case graphics
		<title> = $wii_bandlogo_graphics
		<title_pos> = (56.0, 0.0)
		if GlobalExists \{name = edit_graphics_graphics
				type = array}
			<array_name> = $edit_graphics_graphics
		else
			<array_name> = none
		endif
		case icons
		<title> = $wii_bandlogo_icons
		<title_pos> = (56.0, 0.0)
		if GlobalExists \{name = edit_graphics_icons
				type = array}
			<array_name> = $edit_graphics_icons
		else
			<array_name> = none
		endif
	endswitch
	if NOT IsTrue \{$CJP_my_menu}
		CreateScreenElement {
			type = TextElement
			parent = edit_graphic_action_menu_anchor
			id = edit_graphic_image_menu_title
			font = text_a4
			text = <title>
			scale = 1.1
			rgba = $EG_selected_text_color
			pos = <title_pos>
			just = [left top]
			shadow
			shadow_rgba = $UI_text_shadow_color
			shadow_offs = $UI_text_shadow_offset
			heap = $screen_element_heap
		}
		CreateScreenElement \{parent = edit_graphic_action_menu_anchor
			type = SpriteElement
			texture = up_arrow
			pos = (70.0, 27.0)
			scale = (0.5, 0.5)
			just = [
				left
				top
			]
			heap = $screen_element_heap}
		CreateScreenElement \{parent = edit_graphic_action_menu_anchor
			type = SpriteElement
			texture = up_arrow
			pos = (142.0, 27.0)
			scale = (0.5, 0.5)
			just = [
				left
				top
			]
			heap = $screen_element_heap}
		CreateScreenElement \{parent = edit_graphic_action_menu_anchor
			type = SpriteElement
			texture = down_arrow
			pos = (70.0, 323.0)
			scale = (0.5, 0.5)
			just = [
				left
				top
			]
			heap = $screen_element_heap}
		CreateScreenElement \{parent = edit_graphic_action_menu_anchor
			type = SpriteElement
			texture = down_arrow
			pos = (142.0, 323.0)
			scale = (0.5, 0.5)
			just = [
				left
				top
			]
			heap = $screen_element_heap}
		CreateScreenElement \{type = VScrollingMenu
			parent = edit_graphic_action_menu_anchor
			id = edit_graphic_image_vscrollingmenu
			just = [
				left
				top
			]
			pos = (0.0, 38.0)
			dims = (224.0, 284.0)
			alpha = 0
			heap = $screen_element_heap}
		CreateScreenElement {
			type = VMenu
			parent = edit_graphic_image_vscrollingmenu
			id = edit_graphic_image_vmenu
			spacing_between = 4
			pos = (0.0, 0.0)
			just = [left top]
			dims = (224.0, 284.0)
			tags = {category_index = <index>}
			heap = $screen_element_heap
		}
		SetScreenElementProps \{id = edit_graphic_image_vmenu
			event_handlers = [
				{
					pad_back
					generic_menu_pad_back_sound
				}
				{
					pad_back
					edit_graphic_image_menu_exit
				}
				{
					pad_up
					generic_menu_up_or_down_sound
					params = {
						up
					}
				}
				{
					pad_down
					generic_menu_up_or_down_sound
					params = {
						down
					}
				}
			]
			replace_handlers}
		if NOT (<array_name> = none)
			GetArraySize <array_name> GlobalArray
			<index> = 0
			<hcounter> = 0
			<row_counter> = 0
			begin
			if (<hcounter> = 0)
				FormatText checksumname = menu_id qs(0xdff49187) i = <row_counter>
				CreateScreenElement {
					type = HMenu
					parent = edit_graphic_image_vmenu
					id = <menu_id>
					spacing_between = 4
					dims = (224.0, 68.0)
					pos = (0.0, 0.0)
					just = [left top]
					heap = $screen_element_heap
				}
				AssignAlias id = <menu_id> alias = current_image_hmenu
				<row_counter> = (<row_counter> + 1)
			endif
			texture_struct = (<array_name> [<index>])
			texture = (<texture_struct>.texture)
			FormatText checksumname = texture_id qs("%t") t = <texture>
			edit_graphic_add_image_menu_item texture = <texture_id> texture_name = <texture> index = <index> hindex = <hcounter>
			<hcounter> = (<hcounter> + 1)
			if (<hcounter> = 3)
				<hcounter> = 0
			endif
			<index> = (<index> + 1)
			repeat <array_size>
		endif
		if ((<hcounter> < 3) && (<hcounter> > 0))
			begin
			CreateScreenElement \{parent = current_image_hmenu
				type = ContainerElement
				dims = (68.0, 68.0)
				not_focusable
				just = [
					left
					top
				]
				heap = $screen_element_heap}
			<hcounter> = (<hcounter> + 1)
			if (<hcounter> = 3)
				break
			endif
			repeat
		endif
		grad_color = [255 255 255 255]
		CreateScreenElement {
			type = SpriteElement
			parent = edit_graphic_action_menu_anchor
			id = grad_bar_left
			texture = goal_grad
			rgba = <grad_color>
			scale = (10.2, 1.0)
			pos = (230.0, 24.0)
			just = [left top]
			z_priority = 35
			rot_angle = 89.9
		}
		create_scroll_bar parent = edit_graphic_action_menu_anchor VMenu = edit_graphic_image_vmenu items = <array_size> cols = 3 pos = (235.0, 22.0) size_height = 316
		CreateScreenElement {
			type = SpriteElement
			parent = edit_graphic_action_menu_anchor
			id = grad_bar_right
			texture = goal_grad
			rgba = <grad_color>
			scale = (10.2, 1.0)
			pos = (242.0, 24.0)
			just = [left top]
			z_priority = 35
			rot_angle = 89.9
		}
		change \{EG_image_item_menu_selection = 0}
		Wait \{2
			gameframes}
		SetScreenElementProps \{id = edit_graphic_image_vscrollingmenu
			reset_window_top}
		SetScreenElementProps \{id = edit_graphic_image_vscrollingmenu
			alpha = 1}
		LaunchEvent \{type = focus
			target = edit_graphic_image_vmenu}
	else
		if ScreenElementExists \{id = cagr_edit_vmenu}
			DestroyScreenElement \{id = cagr_edit_vmenu}
		endif
		make_generic_menu {
			vmenu_id = cagr_edit_vmenu
			pad_back_script = edit_graphic_create_category_menu
			pad_back_params = {from_layer_list}
			title = <title>
			num_icons = 1
		}
		if NOT (<array_name> = none)
			GetArraySize <array_name> GlobalArray
			<index> = 0
			<hcounter> = 0
			<row_counter> = 0
			begin
			texture_struct = (<array_name> [<index>])
			texture = (<texture_struct>.texture)
			name = (<texture_struct>.name)
			FormatText checksumname = texture_id '%t' t = <texture>
			add_generic_menu_text_item {
				text = <name>
				additional_focus_script = edit_graphic_image_item_focus
				additional_focus_params = {name = <texture_id>}
				pad_choose_script = edit_graphic_image_item_select
				pad_choose_params = {texture = <texture_id> texture_name = <name>}
			}
			<index> = (<index> + 1)
			repeat <array_size>
		endif
		LaunchEvent \{type = focus
			target = cagr_edit_vmenu}
		add_user_control_helper \{button = green
			text = $wii_bandlogo_select}
		add_user_control_helper \{button = red
			text = $wii_back}
	endif
endscript

script edit_graphic_add_image_menu_item 
	FormatText checksumname = id qs("%a%b") a = <index> b = <texture_name>
	CreateScreenElement {
		parent = current_image_hmenu
		type = ContainerElement
		id = <id>
		dims = (100.0, 100.0)
		event_handlers = [{focus edit_graphic_image_item_focus params = {id = <id> index = <hindex>}}
			{unfocus edit_graphic_image_item_unfocus params = {id = <id>}}
			{pad_choose generic_menu_pad_choose_sound}
			{pad_choose edit_graphic_image_item_select params = {texture = <texture> texture_name = <texture_name>}}
			{pad_start null_script}
		]
		just = [center top]
		heap = $screen_element_heap
	}
	<item_id> = <id>
	CreateScreenElement {
		parent = <item_id>
		type = SpriteElement
		texture = white2
		rgba = $EG_unselected_image_color
		scale = (8.5, 8.5)
		pos = (0.0, 0.0)
		just = [left top]
		heap = $screen_element_heap
	}
	CreateScreenElement {
		parent = <item_id>
		type = SpriteElement
		texture = white2
		rgba = $EG_image_background_color
		scale = (7.5, 7.5)
		pos = (4.0, 4.0)
		just = [left top]
		z_priority = 8
		heap = $screen_element_heap
	}
	CreateScreenElement {
		type = SpriteElement
		parent = <item_id>
		texture = <texture>
		z_priority = 9
		scale = (1.5, 1.5)
		pos = (5.0, 6.0)
		just = [left top]
		z_priority = 9
		heap = $screen_element_heap
	}
endscript

script edit_graphic_image_menu_exit 
	if (EG_graphic_item_selected = 0)
		edit_graphic_image_vmenu :GetTags
		edit_graphic_create_action_menu_anchor \{menu_type = category_menu}
		LaunchEvent \{type = focus
			target = edit_graphic_category_vmenu}
		if NOT (<category_index> = 0)
			begin
			LaunchEvent \{type = pad_down
				target = edit_graphic_category_vmenu}
			repeat <category_index>
		endif
	else
		edit_graphic_category_menu_back
	endif
endscript
EG_image_item_menu_selection = 0

script edit_graphic_image_item_menu_focus 
	<menu_id> :GetTags
	if GotParam \{tag_selected_index}
		if NOT (<tag_selected_index> = $EG_image_item_menu_selection)
			if (<tag_selected_index> > $EG_image_item_menu_selection)
				<num_pads> = (<tag_selected_index> - $EG_image_item_menu_selection)
				<pad_event> = pad_left
			else
				<num_pads> = ($EG_image_item_menu_selection - <tag_selected_index>)
				<pad_event> = pad_right
			endif
			Wait \{1
				gameframe}
			change \{ok_pad_left_right = 0}
			begin
			LaunchEvent type = <pad_event> target = <menu_id>
			repeat <num_pads>
			change \{ok_pad_left_right = 1}
		endif
	endif
endscript

script edit_graphic_image_item_focus \{name = 0}
	if NOT ((<name>) = cag_workspace)
		edit_graphic_change_layer_info_value change_texture_id = <name>
		edit_graphic_prepare_sprite_infos
		GenerateCAGTexture info_array = <sprite_infos> player = <currentSkaterProfileIndex> test = 0
		Wait \{1
			gameframes}
	endif
	if ScreenElementExists \{id = band_logo_preview_sprite}
		return
	endif
	if ScreenElementExists \{id = image_preview}
		DestroyScreenElement \{id = image_preview}
	endif
	CreateScreenElement \{type = SpriteElement
		parent = root_window
		id = image_preview
		pos = (822.0, 265.0)
		texture = cag_workspace
		scale = 1.26}
endscript

script edit_graphic_image_item_unfocus 
	KillSpawnedScript \{name = edit_graphic_image_focus_glow}
	SetScreenElementProps {
		id = {<id> child = 0}
		rgba = $EG_unselected_image_color
		alpha = 1
		time = 0
	}
endscript

script edit_graphic_image_item_select 
	change \{EG_graphic_item_selected = 1}
	edit_graphic_change_layer_info_value change_texture_id = <texture> change_texture_name = <texture_name>
	if NOT IsTrue \{$CJP_my_menu}
		edit_graphic_update_layer_graphics \{update_all = 0
			index = $EG_current_layer_menu_index}
	else
		edit_graphic_prepare_sprite_infos
		GenerateCAGTexture info_array = <sprite_infos> player = <currentSkaterProfileIndex> test = 0
		if ScreenElementExists \{id = image_preview}
			SetScreenElementProps \{id = image_preview
				texture = cag_workspace}
		elseif ScreenElementExists \{id = band_logo_preview_sprite}
			SetScreenElementProps \{id = band_logo_preview_sprite
				texture = cag_workspace}
		endif
		Wait \{2
			gameframes}
		edit_graphic_image_item_focus \{name = cag_workspace}
		edit_graphic_create_layer_menu
	endif
endscript

script edit_graphic_create_canvas \{bg_texture = white2}
	CreateScreenElement \{type = ContainerElement
		parent = edit_graphic_main_menu_anchor
		id = edit_graphic_canvas_anchor
		pos = (370.0, 65.0)
		just = [
			left
			top
		]
		heap = $screen_element_heap}
	title_color = [255 , 255 , 255 , 255]
	CreateScreenElement {
		type = TextElement
		parent = edit_graphic_canvas_anchor
		id = edit_graphic_canvas_title
		font = text_a4
		text = qs(0xe6513af4)
		scale = 1.1
		rgba = <title_color>
		pos = (76.0, 0.0)
		just = [left top]
		shadow
		shadow_rgba = $UI_text_shadow_color
		shadow_offs = $UI_text_shadow_offset
		heap = $screen_element_heap
	}
	if ($EG_creating_premade)
		CreateScreenElement \{parent = edit_graphic_canvas_anchor
			type = SpriteElement
			texture = white2
			rgba = $EG_premade_key_color
			pos = (23.0, 40.0)
			just = [
				left
				top
			]
			z_priority = -1
			scale = 24
			heap = $screen_element_heap}
	endif
	CreateScreenElement \{parent = edit_graphic_canvas_anchor
		type = SpriteElement
		texture = bg_gradient_1
		rgba = [
			100
			100
			100
			20
		]
		scale = (0.72999996, 45.0)
		pos = (28.0, 46.0)
		just = [
			left
			top
		]
		z_priority = -2
		heap = $screen_element_heap}
	CreateScreenElement \{type = ContainerElement
		parent = edit_graphic_canvas_anchor
		id = edit_graphic_canvas_space
		pos = (227.0, 242.0)
		dims = (184.0, 184.0)
		just = [
			left
			top
		]
		heap = $screen_element_heap}
	CreateScreenElement \{parent = edit_graphic_canvas_space
		type = WindowElement
		id = edit_graphic_canvas_clip
		pos = (0.0, 0.0)
		dims = (184.0, 184.0)
		just = [
			left
			top
		]
		heap = $screen_element_heap}
	GetArraySize \{$edit_graphic_layer_infos}
	<index> = 0
	begin
	if (($edit_graphic_layer_infos [<index>].texture_id) = none)
		<texture> = white2
		<current_scaling> = 1
	else
		<texture> = ($edit_graphic_layer_infos [<index>].texture_id)
		<current_scaling> = ($edit_graphic_layer_infos [<index>].scale_x)
	endif
	CreateScreenElement {
		parent = edit_graphic_canvas_clip
		type = SpriteElement
		texture = <texture>
		scale = (<current_scaling> * $EG_canvas_scale_factor)
		pos = (0.0, 0.0)
		just = [center center]
		internal_just = [center center]
		z_priority = ($EG_canvas_base_z + <index>)
		heap = $screen_element_heap
	}
	edit_graphic_change_layer_info_value use_current = 0 index = <index> change_canvas_id = <id>
	<index> = (<index> + 1)
	repeat <array_size>
endscript

script edit_graphic_copy_to_open_layer 
	<current_index> = ($EG_current_layer_info_index)
	<new_index> = 0
	begin
	if (($edit_graphic_layer_infos [<new_index>].texture_id) = none)
		break
	endif
	<new_index> = (<new_index> + 1)
	repeat ($edit_graphic_max_layers)
	if ((<new_index>) >= ($edit_graphic_max_layers))
		create_new_generic_popup \{popup_type = error_menu
			error_func = destroy_generic_popup
			text = $wii_bandlogo_no_open_layers}
		return
	endif
	SetArrayElement {ArrayName = edit_graphic_layer_infos GlobalArray index = <new_index>
		newvalue = {texture_id = ($edit_graphic_layer_infos [<current_index>].texture_id)
			texture_name = ($edit_graphic_layer_infos [<current_index>].texture_name)
			string = ($edit_graphic_layer_infos [<current_index>].string)
			canvas_id = ($edit_graphic_layer_infos [<current_index>].canvas_id)
			font_id = ($edit_graphic_layer_infos [<current_index>].font_id)
			pos_x = ($edit_graphic_layer_infos [<current_index>].pos_x)
			pos_y = ($edit_graphic_layer_infos [<current_index>].pos_y)
			rot = ($edit_graphic_layer_infos [<current_index>].rot)
			scale_x = ($edit_graphic_layer_infos [<current_index>].scale_x)
			scale_y = ($edit_graphic_layer_infos [<current_index>].scale_y)
			flip_h = ($edit_graphic_layer_infos [<current_index>].flip_h)
			flip_v = ($edit_graphic_layer_infos [<current_index>].flip_v)
			hsva = ($edit_graphic_layer_infos [<current_index>].hsva)
			shear_x = ($edit_graphic_layer_infos [<current_index>].shear_x)
			shear_y = ($edit_graphic_layer_infos [<current_index>].shear_y)
			color = ($edit_graphic_layer_infos [<current_index>].color)
			layer_id = <new_index>}
	}
	edit_graphic_prepare_sprite_infos
	GenerateCAGTexture info_array = <sprite_infos> player = <currentSkaterProfileIndex> test = 0
	change EG_current_layer_info_index = <new_index>
endscript

script edit_graphic_check_clear_current_layer 
	create_new_generic_popup \{popup_type = yes_no_menu
		yes_func = edit_graphic_clear_current_layer
		no_func = destroy_generic_popup
		focus_no
		text = $wii_bandlogo_erase_warning
		title = $wii_bandlogo_erase_title
		title_effect}
endscript

script edit_graphic_clear_current_layer 
	destroy_generic_popup
	<current_index> = ($EG_current_layer_info_index)
	<max_index> = (($edit_graphic_max_layers) - 1)
	if ((<current_index>) < (<max_index>))
		begin
		<new_index> = (<current_index> + 1)
		SetArrayElement {ArrayName = edit_graphic_layer_infos GlobalArray index = <current_index>
			newvalue = {texture_id = ($edit_graphic_layer_infos [<new_index>].texture_id)
				texture_name = ($edit_graphic_layer_infos [<new_index>].texture_name)
				string = ($edit_graphic_layer_infos [<new_index>].string)
				canvas_id = ($edit_graphic_layer_infos [<new_index>].canvas_id)
				font_id = ($edit_graphic_layer_infos [<new_index>].font_id)
				pos_x = ($edit_graphic_layer_infos [<new_index>].pos_x)
				pos_y = ($edit_graphic_layer_infos [<new_index>].pos_y)
				rot = ($edit_graphic_layer_infos [<new_index>].rot)
				scale_x = ($edit_graphic_layer_infos [<new_index>].scale_x)
				scale_y = ($edit_graphic_layer_infos [<new_index>].scale_y)
				flip_h = ($edit_graphic_layer_infos [<new_index>].flip_h)
				flip_v = ($edit_graphic_layer_infos [<new_index>].flip_v)
				hsva = ($edit_graphic_layer_infos [<new_index>].hsva)
				shear_x = ($edit_graphic_layer_infos [<new_index>].shear_x)
				shear_y = ($edit_graphic_layer_infos [<new_index>].shear_y)
				color = ($edit_graphic_layer_infos [<new_index>].color)
				layer_id = <current_index>}
		}
		<current_index> = <new_index>
		if ((<current_index>) = (<max_index>))
			break
		endif
		if (($edit_graphic_layer_infos [<current_index>].texture_id) = none)
			break
		endif
		repeat
	endif
	SetArrayElement {ArrayName = edit_graphic_layer_infos GlobalArray index = <current_index>
		newvalue = {texture_id = ($default_graphic_layer_info [<current_index>].texture_id)
			texture_name = ($default_graphic_layer_info [<current_index>].texture_name)
			string = ($default_graphic_layer_info [<current_index>].string)
			canvas_id = ($default_graphic_layer_info [<current_index>].canvas_id)
			font_id = ($default_graphic_layer_info [<current_index>].font_id)
			pos_x = ($default_graphic_layer_info [<current_index>].pos_x)
			pos_y = ($default_graphic_layer_info [<current_index>].pos_y)
			rot = ($default_graphic_layer_info [<current_index>].rot)
			scale_x = ($default_graphic_layer_info [<current_index>].scale_x)
			scale_y = ($default_graphic_layer_info [<current_index>].scale_y)
			flip_h = ($default_graphic_layer_info [<current_index>].flip_h)
			flip_v = ($default_graphic_layer_info [<current_index>].flip_v)
			hsva = ($default_graphic_layer_info [<current_index>].hsva)
			shear_x = ($default_graphic_layer_info [<current_index>].shear_x)
			shear_y = ($default_graphic_layer_info [<current_index>].shear_y)
			color = ($default_graphic_layer_info [<current_index>].color)
			layer_id = <current_index>}
	}
	edit_graphic_prepare_sprite_infos
	GenerateCAGTexture info_array = <sprite_infos> player = <currentSkaterProfileIndex> test = 0
	edit_graphic_create_main_menu
endscript

script edit_graphic_swap_layers 
	<current_index> = ($EG_current_layer_info_index)
	<new_index> = 0
	if (GotParam swap_up)
		<new_index> = (<current_index> - 1)
	endif
	if (GotParam swap_down)
		<new_index> = (<current_index> + 1)
	endif
	if ((<new_index>) < 0)
		create_new_generic_popup \{popup_type = error_menu
			error_func = destroy_generic_popup
			text = $wii_bandlogo_cant_move_back}
		return
	endif
	<index> = 0
	begin
	if (($edit_graphic_layer_infos [<index>].texture_id) = none)
		break
	endif
	<index> = (<index> + 1)
	repeat ($edit_graphic_max_layers)
	if ((<new_index>) >= (<index>))
		create_new_generic_popup \{popup_type = error_menu
			error_func = destroy_generic_popup
			text = $wii_bandlogo_cant_move_forward}
		return
	endif
	change temporary_graphic_layer_info = ($edit_graphic_layer_infos [<new_index>])
	edit_graphic_get_array_info_vals index = <current_index>
	SetArrayElement {ArrayName = edit_graphic_layer_infos GlobalArray index = <new_index>
		newvalue = {texture_id = <texture_id> texture_name = <texture_name> string = <string> canvas_id = <canvas_id>
			font_id = <font_id> pos_x = <pos_x> pos_y = <pos_y> rot = <rot> scale_x = <scale_x> scale_y = <scale_y>
			flip_h = <flip_h> flip_v = <flip_v> hsva = <hsva> shear_x = <shear_x> shear_y = <shear_y>
			color = <color>}
	}
	SetArrayElement {ArrayName = edit_graphic_layer_infos GlobalArray index = <new_index>
		newvalue = {texture_id = ($edit_graphic_layer_infos [<current_index>].texture_id)
			texture_name = ($edit_graphic_layer_infos [<current_index>].texture_name)
			string = ($edit_graphic_layer_infos [<current_index>].string)
			canvas_id = ($edit_graphic_layer_infos [<current_index>].canvas_id)
			font_id = ($edit_graphic_layer_infos [<current_index>].font_id)
			pos_x = ($edit_graphic_layer_infos [<current_index>].pos_x)
			pos_y = ($edit_graphic_layer_infos [<current_index>].pos_y)
			rot = ($edit_graphic_layer_infos [<current_index>].rot)
			scale_x = ($edit_graphic_layer_infos [<current_index>].scale_x)
			scale_y = ($edit_graphic_layer_infos [<current_index>].scale_y)
			flip_h = ($edit_graphic_layer_infos [<current_index>].flip_h)
			flip_v = ($edit_graphic_layer_infos [<current_index>].flip_v)
			hsva = ($edit_graphic_layer_infos [<current_index>].hsva)
			shear_x = ($edit_graphic_layer_infos [<current_index>].shear_x)
			shear_y = ($edit_graphic_layer_infos [<current_index>].shear_y)
			color = ($edit_graphic_layer_infos [<current_index>].color)
			layer_id = <new_index>}
	}
	SetArrayElement {ArrayName = edit_graphic_layer_infos GlobalArray index = <current_index>
		newvalue = {texture_id = ($temporary_graphic_layer_info.texture_id)
			texture_name = ($temporary_graphic_layer_info.texture_name)
			string = ($temporary_graphic_layer_info.string)
			canvas_id = ($temporary_graphic_layer_info.canvas_id)
			font_id = ($temporary_graphic_layer_info.font_id)
			pos_x = ($temporary_graphic_layer_info.pos_x)
			pos_y = ($temporary_graphic_layer_info.pos_y)
			rot = ($temporary_graphic_layer_info.rot)
			scale_x = ($temporary_graphic_layer_info.scale_x)
			scale_y = ($temporary_graphic_layer_info.scale_y)
			flip_h = ($temporary_graphic_layer_info.flip_h)
			flip_v = ($temporary_graphic_layer_info.flip_v)
			hsva = ($temporary_graphic_layer_info.hsva)
			shear_x = ($temporary_graphic_layer_info.shear_x)
			shear_y = ($temporary_graphic_layer_info.shear_y)
			color = ($temporary_graphic_layer_info.color)
			layer_id = <current_index>}
	}
	edit_graphic_prepare_sprite_infos
	GenerateCAGTexture info_array = <sprite_infos> player = <currentSkaterProfileIndex> test = 0
	change EG_current_layer_info_index = <new_index>
endscript

script edit_graphic_change_color 
	if (GotParam color)
		edit_graphic_change_layer_info_value change_color = <color>
	endif
	edit_graphic_prepare_sprite_infos
	GenerateCAGTexture info_array = <sprite_infos> player = <currentSkaterProfileIndex> test = 0
endscript

script edit_graphic_flip_layer 
	if (GotParam horiz)
		<flip_h> = (1 - ($edit_graphic_layer_infos [$EG_current_layer_info_index].flip_h))
		edit_graphic_change_layer_info_value change_flip_h = <flip_h>
		($horizontal_flip_id) :GetTags
		if ((<flip_h>) = 1)
			<backing_id> :SetTags {on = true}
			SetScreenElementProps id = <backing_id> alpha = 1
		else
			<backing_id> :SetTags {on = false}
			SetScreenElementProps id = <backing_id> alpha = 0
		endif
	endif
	if (GotParam vert)
		<flip_v> = (1 - ($edit_graphic_layer_infos [$EG_current_layer_info_index].flip_v))
		edit_graphic_change_layer_info_value change_flip_v = <flip_v>
		($vertical_flip_id) :GetTags
		if ((<flip_v>) = 1)
			<backing_id> :SetTags {on = true}
			SetScreenElementProps id = <backing_id> alpha = 1
		else
			<backing_id> :SetTags {on = false}
			SetScreenElementProps id = <backing_id> alpha = 0
		endif
	endif
	if NOT IsTrue \{$CJP_my_menu}
		edit_graphic_update_layer_graphics \{update_all = 0
			index = $EG_current_layer_menu_index}
	else
		edit_graphic_prepare_sprite_infos
		GenerateCAGTexture info_array = <sprite_infos> player = <currentSkaterProfileIndex> test = 0
	endif
endscript

script edit_graphic_clear_all_prompt 
	create_new_generic_popup \{popup_type = yes_no_menu
		yes_func = edit_graphic_clear_all
		yes_func_params = {
			refresh
		}
		no_func = destroy_generic_popup
		focus_no
		text = $wii_bandlogo_erase_all_warning
		title = $wii_bandlogo_erase_all_title
		title_effect}
endscript

script edit_graphic_clear_all 
	destroy_generic_popup
	GetArraySize ($edit_graphic_layer_infos)
	if ((<array_size>) = 0)
		change edit_graphic_layer_infos = ($default_graphic_layer_info)
	endif
	<current_index> = ($EG_current_layer_info_index)
	<max_index> = (($edit_graphic_max_layers) - 1)
	<index> = 0
	begin
	SetArrayElement {ArrayName = edit_graphic_layer_infos GlobalArray index = <index>
		newvalue = {texture_id = ($default_graphic_layer_info [<index>].texture_id)
			texture_name = ($default_graphic_layer_info [<index>].texture_name)
			string = ($default_graphic_layer_info [<index>].string)
			canvas_id = ($default_graphic_layer_info [<index>].canvas_id)
			font_id = ($default_graphic_layer_info [<index>].font_id)
			pos_x = ($default_graphic_layer_info [<index>].pos_x)
			pos_y = ($default_graphic_layer_info [<index>].pos_y)
			rot = ($default_graphic_layer_info [<index>].rot)
			scale_x = ($default_graphic_layer_info [<index>].scale_x)
			scale_y = ($default_graphic_layer_info [<index>].scale_y)
			flip_h = ($default_graphic_layer_info [<index>].flip_h)
			flip_v = ($default_graphic_layer_info [<index>].flip_v)
			hsva = ($default_graphic_layer_info [<index>].hsva)
			shear_x = ($default_graphic_layer_info [<index>].shear_x)
			shear_y = ($default_graphic_layer_info [<index>].shear_y)
			color = ($default_graphic_layer_info [<index>].color)
			layer_id = <index>}
	}
	index = (<index> + 1)
	if (<index> = ($edit_graphic_max_layers))
		break
	endif
	repeat
	if GotParam \{refresh}
		edit_graphic_prepare_sprite_infos
		GenerateCAGTexture info_array = <sprite_infos> player = <currentSkaterProfileIndex> test = 0
	endif
endscript

script edit_graphic_build_image_string 
	<layer_string> = ($edit_graphic_layer_infos [<info_index>].string)
	StringToCharArray string = <layer_string>
	GetArraySize <char_array>
	<font_spacing> = (EG_font_names [($edit_graphic_layer_infos [<info_index>].font_id)].spacing)
	<char_image_size> = ((64.0 / <array_size>))
	<char_x_pos> = ((0 - ((<char_image_size> * <array_size>) / 2)) + (<char_image_size> / 2))
	<char_y_pos> = 0
	<canvas_id> = ($edit_graphic_layer_infos [<info_index>].canvas_id)
	<font> = (EG_font_names [($edit_graphic_layer_infos [<info_index>].font_id)].name)
	<scale> = (<char_image_size> / 64.0)
	if NOT (<array_size> = 1)
		if NOT (<font_spacing> = 0)
			<scale> = (<scale> * (1 / <font_spacing>))
		endif
	endif
	SetScreenElementLock id = <canvas_id> off
	<index> = 0
	begin
	<pos> = (((1.0, 0.0) * <char_x_pos>) + ((0.0, 1.0) * <char_y_pos>))
	<char> = (<char_array> [<index>])
	if (<char> = qs(" "))
		FormatText checksumname = texture qs(0x1a6ee5f1) f = <font> l = <char>
		<rgba> = [255 , 255 , 255 , 0]
	else
		FormatText checksumname = texture qs(0x00f937a4) f = <font> l = <char>
		HSVtoRGB hsv = ($edit_graphic_layer_infos [<info_index>].hsva)
		<rgba> = <rgb>
	endif
	CreateScreenElement {
		parent = <canvas_id>
		type = SpriteElement
		texture = <texture>
		rgba = <rgba>
		scale = <scale>
		pos = <pos>
		just = [center center]
		z_priority = ($EG_canvas_base_z + <menu_index>)
		tags = {current_texture = <texture>}
		heap = $screen_element_heap
	}
	<char_x_pos> = (<char_x_pos> + <char_image_size>)
	<index> = (<index> + 1)
	repeat <array_size>
	SetScreenElementLock id = <canvas_id>
endscript

script edit_graphic_destroy_image_string \{use_current = 1}
	if (<use_current> = 1)
		<info_index> = $EG_current_layer_info_index
	else
		<info_index> = <info_index>
	endif
	<canvas_id> = ($edit_graphic_layer_infos [<info_index>].canvas_id)
	GetScreenElementChildren id = <canvas_id>
	if (GotParam children)
		SetScreenElementLock id = <canvas_id> off
		GetArraySize <children>
		<index> = 0
		begin
		<child_id> = (<children> [<index>])
		DestroyScreenElement id = <child_id>
		<index> = (<index> + 1)
		repeat <array_size>
		SetScreenElementLock id = <canvas_id>
	endif
endscript
