script edit_graphic_launch_cagr 
	change \{eg_in_create_a_graphic = 1}
	SpawnScriptLater \{edit_graphic_create_pre_menu
		params = {
			from_launch = 1
		}}
	edit_graphic_prepare_sprite_infos
	GenerateCAGTexture info_array = <sprite_infos> player = <currentSkaterProfileIndex> test = 0
endscript

script edit_graphic_delayed_image_preview 
	Wait \{2
		gameframes}
	edit_graphic_image_item_focus \{name = cag_workspace}
endscript

script edit_graphic_create_pre_menu \{from_launch = 0}
	if ScreenElementExists \{id = band_name_text}
		DestroyScreenElement \{id = band_name_text}
	endif
	if ScreenElementExists \{id = menu_backdrop_container}
		DestroyScreenElement \{id = menu_backdrop_container}
	endif
	if ScreenElementExists \{id = menu_backdrop}
		DestroyScreenElement \{id = menu_backdrop}
	endif
	if ScreenElementExists \{id = cagr_edit_vmenu}
		DestroyScreenElement \{id = cagr_edit_vmenu}
	endif
	CreateScreenElement \{type = ContainerElement
		parent = root_window
		id = menu_backdrop_container
		pos = (0.0, 0.0)
		just = [
			left
			top
		]}
	FormatText checksumname = bandname_id 'band%i_info' i = ($current_band)
	GetGlobalTags <bandname_id> param = name
	make_generic_menu \{vmenu_id = cagr_edit_vmenu
		title = $wii_bandlogo_edit_band_logo
		num_icons = 1}
	add_generic_menu_icon_item \{icon = icon_current
		text = $wii_bandlogo_edit
		pad_choose_script = edit_graphic_create_main_menu}
	add_generic_menu_icon_item \{icon = icon_save
		text = $wii_bandlogo_save
		pad_choose_script = leaving_band_name_logo
		pad_choose_params = {
			func = generic_event_replace
			func_params = {
				state = UIstate_cas_save_slots
				data = {
					text = $wii_bandlogo_save
					slot_list = player_created_graphics_save
					save_cap
					hist_tex = icon_save
				}
			}
		}}
	add_generic_menu_icon_item {
		icon = icon_load
		text = $wii_bandlogo_load
		pad_choose_script = create_new_generic_popup
		pad_choose_params = {
			popup_type = yes_no_menu
			focus_index = 1
			title = $wii_bandlogo_load_design
			text = $wii_bandlogo_load_warning
			yes_func = leaving_band_name_logo
			yes_func_params = {
				func = generic_event_replace
				func_params = {state = UIstate_cas_save_slots data = {savegame = <savegame> text = qs("Load") slot_list = player_created_graphics_save part = <part> div_id = <div_id> load_design hist_tex = icon_load camera_list = <camera_list> zoom_camera = <zoom_camera> no_show_history = <no_show_history>}}
			}
			no_func = destroy_generic_popup
		}
	}
	add_generic_menu_icon_item \{icon = icon_random
		text = $wii_bandlogo_random
		pad_choose_script = randomize_band_logo}
	add_generic_menu_icon_item \{icon = icon_remove
		text = $wii_bandlogo_clear
		pad_choose_script = edit_graphic_clear_all_prompt
		pad_choose_params = {
			refresh
		}}
	menu_finish
	LaunchEvent \{type = focus
		target = cagr_edit_vmenu}
	if GetCurrentCASObject
		ps2_get_musician_context_data name = <cas_object>
		SetCASAppearance appearance = ($<bandmember_appearance>)
	else
		SetCASAppearance \{appearance = {
			}}
	endif
	if NOT IsTrue \{$CJP_my_menu}
		edit_graphic_create_layer_menu \{only_preview}
		SetScreenElementLock \{id = edit_graphic_main_menu_anchor
			off}
		edit_graphic_create_canvas
		edit_graphic_update_layer_graphics
	else
		change \{cas_current_appearance = {
				CAS_Band_Logo = {
					desc_id = CAS_Band_Logo_id
				}
			}}
	endif
endscript

script edit_graphic_confirm_new_dialog 
	LaunchEvent \{type = unfocus
		target = current_menu}
	<yes_script> {<yes_params>}
endscript

script edit_graphic_confirm_new_dialog_exit 
	LaunchEvent \{type = focus
		target = current_menu}
	dialog_box_exit \{no_pad_start}
endscript
EG_premade_item_menu_selection = 0

script edit_graphic_create_premade_menu 
	dialog_box_exit \{no_pad_start}
	if IsNgc
		MemPushContext \{TopDownHeap}
		change \{screen_element_heap = TopDown}
	else
		change \{screen_element_heap = heap_frontend}
	endif
	if ScreenElementExists \{id = current_menu_anchor}
		DestroyScreenElement \{id = current_menu_anchor}
	endif
	SetScreenElementLock \{id = root_window
		off}
	CreateScreenElement \{type = ContainerElement
		parent = root_window
		id = current_menu_anchor
		dims = (640.0, 480.0)
		pos = (320.0, 240.0)
		heap = $screen_element_heap}
	build_theme_sub_title \{title = $wii_bandlogo_load_premade}
	create_helper_text \{helper_text_elements = [
			{
				text = qs(0x9cfa1170)
			}
			{
				text = qs(0xb2073e6f)
			}
			{
				text = qs(0x2bf42f3d)
			}
		]}
	CreateScreenElement \{type = VScrollingMenu
		parent = current_menu_anchor
		id = edit_graphic_image_vscrollingmenu
		just = [
			left
			top
		]
		pos = (50.0, 88.0)
		dims = (224.0, 284.0)
		alpha = 0
		heap = $screen_element_heap}
	CreateScreenElement {
		type = VMenu
		parent = edit_graphic_image_vscrollingmenu
		id = edit_graphic_image_vmenu
		spacing_between = 4
		pos = (0.0, 0.0)
		just = [left top]
		dims = (224.0, 284.0)
		tags = {category_index = <index>}
		heap = $screen_element_heap
	}
	SetScreenElementProps \{id = edit_graphic_image_vmenu
		event_handlers = [
			{
				pad_back
				generic_menu_pad_back_sound
			}
			{
				pad_back
				edit_graphic_exit_premade_menu
				params = {
					new_script = edit_graphic_create_pre_menu
				}
			}
			{
				pad_up
				generic_menu_up_or_down_sound
				params = {
					up
				}
			}
			{
				pad_down
				generic_menu_up_or_down_sound
				params = {
					down
				}
			}
		]
		replace_handlers}
	GetArraySize \{edit_graphic_premade_graphics}
	<index> = 0
	<hcounter> = 0
	<row_counter> = 0
	begin
	if (<hcounter> = 0)
		FormatText checksumname = menu_id qs(0xdff49187) i = <row_counter>
		CreateScreenElement {
			type = HMenu
			parent = edit_graphic_image_vmenu
			id = <menu_id>
			spacing_between = 4
			dims = (224.0, 68.0)
			pos = (0.0, 0.0)
			just = [left top]
			heap = $screen_element_heap
		}
		SetScreenElementProps {
			id = <menu_id>
			event_handlers = [{focus edit_graphic_premade_item_menu_focus params = {menu_id = <menu_id>}}
				{pad_left check_ok_pad_left}
				{pad_right check_ok_pad_right}
			]
			replace_handlers
		}
		AssignAlias id = <menu_id> alias = current_image_hmenu
		<row_counter> = (<row_counter> + 1)
	endif
	edit_graphic_add_premade_menu_item texture = (edit_graphic_premade_graphics [<index>].premade_texture) index = <index> hindex = <hcounter>
	<hcounter> = (<hcounter> + 1)
	if (<hcounter> = 3)
		<hcounter> = 0
	endif
	<index> = (<index> + 1)
	repeat <array_size>
	if ((<hcounter> < 3) && (<hcounter> > 0))
		begin
		CreateScreenElement \{parent = current_image_hmenu
			type = ContainerElement
			dims = (68.0, 68.0)
			not_focusable
			just = [
				left
				top
			]
			heap = $screen_element_heap}
		<hcounter> = (<hcounter> + 1)
		if (<hcounter> = 3)
			break
		endif
		repeat
	endif
	grad_color = [255 255 255 255]
	CreateScreenElement {
		type = SpriteElement
		parent = current_menu_anchor
		id = grad_bar_left
		texture = goal_grad
		rgba = <grad_color>
		scale = (9.2, 1.0)
		pos = (286.0, 84.0)
		just = [left top]
		z_priority = 35
		rot_angle = 89.9
	}
	create_scroll_bar parent = current_menu_anchor VMenu = edit_graphic_image_vmenu items = <array_size> cols = 3 pos = (290.0, 87.0) size_height = 285
	CreateScreenElement {
		type = SpriteElement
		parent = current_menu_anchor
		id = grad_bar_right
		texture = goal_grad
		rgba = <grad_color>
		scale = (9.2, 1.0)
		pos = (297.0, 84.0)
		just = [left top]
		z_priority = 35
		rot_angle = 90
	}
	CreateScreenElement \{type = SpriteElement
		parent = current_menu_anchor
		id = thumbnail_bg
		texture = white2
		rgba = [
			0
			0
			0
			90
		]
		scale = (30.0, 38.0)
		pos = (42.0, 76.0)
		just = [
			left
			top
		]
		z_priority = -4
		rot_angle = 0}
	change \{EG_premade_item_menu_selection = 0}
	if InFrontend
		CreateScreenElement \{type = ContainerElement
			parent = current_menu_anchor
			id = edit_graphic_main_menu_anchor
			pos = (0.0, 0.0)
			dims = (640.0, 480.0)
			just = [
				left
				top
			]
			heap = $screen_element_heap}
		edit_graphic_create_layer_menu \{only_preview}
		SetScreenElementLock \{id = edit_graphic_main_menu_anchor
			off}
		edit_graphic_create_canvas
		edit_graphic_update_layer_graphics
	endif
	Wait \{2
		gameframes}
	SetScreenElementProps \{id = edit_graphic_image_vscrollingmenu
		reset_window_top}
	SetScreenElementProps \{id = edit_graphic_image_vscrollingmenu
		alpha = 1}
	LaunchEvent \{type = focus
		target = edit_graphic_image_vmenu}
endscript

script edit_graphic_exit_premade_menu 
	if ScreenElementExists \{id = current_menu_anchor}
		DestroyScreenElement \{id = current_menu_anchor}
	endif
	if IsNgc
		MemPopContext
	endif
	<new_script> <new_script_params>
endscript

script edit_graphic_add_premade_menu_item 
	FormatText checksumname = id qs(0x28a356d2) a = <index>
	CreateScreenElement {
		parent = current_image_hmenu
		type = ContainerElement
		id = <id>
		dims = (68.0, 68.0)
		event_handlers = [{focus edit_graphic_premade_item_focus params = {id = <id> index = <hindex>}}
			{unfocus edit_graphic_premade_item_unfocus params = {id = <id>}}
			{pad_choose generic_menu_pad_choose_sound}
			{pad_choose edit_graphic_select_premade params = {graphic_index = <index> texture = <texture>}}
			{pad_start null_script}
		]
		just = [left top]
		heap = $screen_element_heap
	}
	<item_id> = <id>
	CreateScreenElement {
		parent = <item_id>
		type = SpriteElement
		texture = white2
		rgba = $EG_unselected_image_color
		scale = (8.5, 8.5)
		pos = (0.0, 0.0)
		just = [left top]
		heap = $screen_element_heap
	}
	CreateScreenElement {
		parent = <item_id>
		type = SpriteElement
		texture = white2
		rgba = $EG_image_background_color
		scale = (7.5, 7.5)
		pos = (4.0, 4.0)
		just = [left top]
		z_priority = 8
		heap = $screen_element_heap
	}
	CreateScreenElement {
		type = SpriteElement
		parent = <item_id>
		texture = <texture>
		z_priority = 9
		scale = (0.9, 0.9)
		pos = (5.0, 6.0)
		just = [left top]
		z_priority = 9
		heap = $screen_element_heap
	}
endscript

script edit_graphic_premade_item_menu_focus 
	<menu_id> :GetTags
	if GotParam \{tag_selected_index}
		if NOT (<tag_selected_index> = EG_premade_item_menu_selection)
			if (<tag_selected_index> > EG_premade_item_menu_selection)
				<num_pads> = (<tag_selected_index> - EG_premade_item_menu_selection)
				<pad_event> = pad_left
			else
				<num_pads> = (EG_premade_item_menu_selection - <tag_selected_index>)
				<pad_event> = pad_right
			endif
			Wait \{1
				gameframe}
			change \{ok_pad_left_right = 0}
			begin
			LaunchEvent type = <pad_event> target = <menu_id>
			repeat <num_pads>
			change \{ok_pad_left_right = 1}
		endif
	endif
endscript

script edit_graphic_premade_item_focus 
	rgba = [255 255 255 255]
	SetScreenElementProps {
		id = {<id> child = 0}
		rgba = <rgba>
	}
	change EG_premade_item_menu_selection = <index>
endscript

script edit_graphic_premade_item_unfocus 
	SetScreenElementProps {
		id = {<id> child = 0}
		rgba = $EG_unselected_image_color
	}
endscript

script edit_graphic_select_premade 
	edit_graphic_set_layer_infos layer_infos = (edit_graphic_premade_graphics [<graphic_index>].premade_layer_infos)
	edit_graphic_exit_premade_menu \{new_script = edit_graphic_create_main_menu}
endscript
screen_element_heap = heap_frontend

script edit_graphic_create_main_menu 
	if IsNgc
		change \{screen_element_heap = TopDownHeap}
	else
		change \{screen_element_heap = heap_frontend}
	endif
	if NOT IsTrue \{$CJP_my_menu}
		clean_up_user_control_helpers
		if ObjectExists \{id = current_menu_anchor}
			DestroyScreenElement \{id = current_menu_anchor}
		endif
		if ObjectExists \{id = edit_graphic_main_menu_anchor}
			DestroyScreenElement \{id = edit_graphic_main_menu_anchor}
		endif
		SetScreenElementLock \{id = root_window
			off}
		CreateScreenElement \{type = ContainerElement
			parent = root_window
			id = edit_graphic_main_menu_anchor
			pos = (0.0, 0.0)
			dims = (640.0, 480.0)
			just = [
				left
				top
			]
			heap = $screen_element_heap}
		AssignAlias \{id = edit_graphic_main_menu_anchor
			alias = current_menu_anchor}
		CreateScreenElement \{type = SpriteElement
			parent = current_menu_anchor
			texture = white2
			pos = (20.0, 80.0)
			scale = (42.0, 40.0)
			rgba = [
				255
				255
				255
				255
			]
			just = [
				left
				top
			]
			rot_angle = 0
			z_priority = -5
			heap = $screen_element_heap}
		kill_start_key_binding
		edit_graphic_create_title
		edit_graphic_create_layer_menu
		edit_graphic_create_action_menu_anchor \{menu_type = tool_menu}
		SetScreenElementLock \{id = edit_graphic_main_menu_anchor
			off}
		edit_graphic_create_canvas
		edit_graphic_update_layer_graphics
		edit_graphic_create_helper_text
		SetScreenElementLock \{id = edit_graphic_main_menu_anchor}
		LaunchEvent \{type = focus
			target = edit_graphic_layer_vmenu}
		LaunchEvent \{type = unfocus
			target = edit_graphic_tool_vmenu}
	else
		if ScreenElementExists \{id = cagr_edit_vmenu}
			DestroyScreenElement \{id = cagr_edit_vmenu}
		endif
		make_generic_menu \{vmenu_id = cagr_edit_vmenu
			title = $wii_bandlogo_layers
			num_icons = 1
			show_history
			pad_back_script = edit_graphic_exit_main_menu}
		<layer_num> = 0
		begin
		if NOT (($edit_graphic_layer_infos [<layer_num>].texture_name) = qs(""))
			<layer_num> = (<layer_num> + 1)
		else
			break
		endif
		repeat ($edit_graphic_max_layers)
		FormatText TextName = LayerCount qs(0x32409292) x = <layer_num> d = ($edit_graphic_max_layers)
		add_generic_menu_text_item {
			text = <LayerCount>
			heading
		}
		if (<layer_num> < ($edit_graphic_max_layers))
			add_generic_menu_text_item {
				text = $wii_bandlogo_new_layer
				pad_choose_script = edit_graphic_layer_item_select
				pad_choose_params = {my_layer = <layer_num> new}
			}
		endif
		<x> = 0
		<my_text> = qs("")
		if (<layer_num> > 0)
			begin
			FormatText TextName = my_text qs("%s") s = ($edit_graphic_layer_infos [<x>].texture_name)
			add_generic_menu_text_item {
				text = <my_text>
				pad_choose_script = edit_graphic_layer_item_select
				pad_choose_params = {my_layer = <x>}
			}
			x = (<x> + 1)
			repeat <layer_num>
		endif
		LaunchEvent \{type = focus
			target = cagr_edit_vmenu}
		add_user_control_helper \{button = green
			text = $wii_bandlogo_select}
		add_user_control_helper \{button = red
			text = $wii_back}
	endif
endscript

script edit_graphic_exit_main_menu 
	if ($EG_creating_premade)
		edit_graphic_print_layers
	endif
	edit_graphic_prepare_sprite_infos
	GenerateCAGTexture info_array = <sprite_infos> player = <currentSkaterProfileIndex> test = 0
	UpdateCurrentCASModel \{buildScript = model_apply_created_texture}
	unpauseskaters
	Wait \{5
		gameframes}
	pauseskaters
	if ScreenElementExists \{id = current_menu_anchor}
		DestroyScreenElement \{id = current_menu_anchor}
	endif
	clean_up_user_control_helpers
	edit_graphic_create_pre_menu
endscript

script edit_graphic_randomize 
	<index> = 0
	begin
	<array_name> = Random (@ edit_graphics_graphics @ edit_graphics_illustrations @ edit_graphics_logos @ edit_graphics_backgrounds @ edit_graphics_odd @ edit_graphics_corp_logo )
	GetArraySize <array_name>
	GetRandomValue name = rval a = 0 b = (<array_size> -1) Integer
	GetTextureFromPath path = (<array_name> [<rval>])
	FormatText checksumname = texture_id qs("%t") t = <texture>
	edit_graphic_change_layer_info_value {
		use_current = 0
		index = <index>
		change_texture_id = <texture_id>
		change_texture_name = <texture>
		change_string = qs("")
		change_font_id = 0
		change_pos_x = (64)
		change_pos_y = (64)
		change_rot = 0
		change_scale_x = 1.0
		change_scale_y = 1.0
		change_flip_h = 0
		change_flip_v = 0
		change_shear = 0.0
		change_skew = 0.0
		change_color = none
		change_h = 0
		change_s = 0
		change_v = 60
		change_a = 255
		change_layer_id = <index>
	}
	<index> = (<index> + 1)
	repeat ($edit_graphic_max_layers)
	change EG_current_layer_menu_index = ($edit_graphic_max_layers)
	change EG_current_layer_info_index = ($edit_graphic_max_layers)
	edit_graphic_update_layer_graphics
endscript

