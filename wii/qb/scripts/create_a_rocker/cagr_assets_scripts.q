script edit_graphic_create_keyboard_menu 
	SetScreenElementProps \{id = edit_graphic_main_menu_anchor
		alpha = 0.0
		time = 0.0}
	SetScreenElementLock \{id = root_window
		off}
	<display_text> = ($edit_graphic_layer_infos [$EG_current_layer_info_index].string)
	create_onscreen_keyboard {keyboard_cancel_script = edit_graphic_exit_keyboard_menu keyboard_cancel_params = {new_text = <new_text>}
		keyboard_done_script = edit_graphic_keyboard_menu_done
		max_length = 10
		text = <display_text>
		new_text = <new_text>
		allowed_characters = [qs("A") qs("B") qs("C") qs("D") qs("E") qs("F") qs("G") qs("H") qs("I")
			qs("J") qs("K") qs("L") qs("M") qs("N") qs("O") qs("P") qs("Q") qs("R")
			qs("S") qs("T") qs("U") qs("V") qs("W") qs("X") qs("Y") qs("Z") qs("0") qs("1")
			qs("2") qs("3") qs("4") qs("5") qs("6") qs("7") qs("8") qs("9") qs(" ")
		]
	}
	SetScreenElementLock \{id = edit_graphic_main_menu_anchor
		off}
	create_helper_text \{helper_text_elements = [
			{
				text = qs(0x9cfa1170)
			}
			{
				text = qs(0xb2073e6f)
			}
			{
				text = qs(0x2bf42f3d)
			}
		]}
	SetScreenElementProps \{id = char_guide_anchor
		alpha = 0}
	change \{keyboard_caps_lock = 1}
	keyboard_change_charset \{charset = alphanumeric_charset_upper
		max_length = 10}
	change \{keyboard_current_charset = alphanumeric_upper}
	SetScreenElementLock \{id = root_window}
endscript

script edit_graphic_check_keyboard_string 
	<is_valid> = 0
	StringToCharArray string = <string>
	GetArraySize <char_array>
	if NOT (<array_size> = 0)
		<index> = 0
		begin
		if NOT ((<char_array> [<index>]) = qs(" "))
			<is_valid> = 1
			break
		endif
		<index> = (<index> + 1)
		repeat <array_size>
	endif
	return got_valid_string = <is_valid>
endscript

script edit_graphic_keyboard_menu_done 
	GetTextElementString \{id = keyboard_current_string}
	edit_graphic_check_keyboard_string string = <string>
	if (<got_valid_string> = 1)
		edit_graphic_change_layer_info_value change_string = <string>
		if NOT (($edit_graphic_layer_infos [$EG_current_layer_info_index].texture_id) = none)
			edit_graphic_change_layer_info_value \{change_texture_id = none
				change_texture_name = qs("")
				change_pos_x = 64
				change_pos_y = 64
				change_rot = 0
				change_scale_x = 1.0
				change_scale_y = 1.0
				change_flip_h = 0
				change_flip_v = 0
				change_h = 0
				change_s = 0
				change_v = 60
				change_a = 255
				change_skew = 0.0
				change_shear = 0.0}
			<canvas_id> = ($edit_graphic_layer_infos [$EG_current_layer_info_index].canvas_id)
			SetScreenElementProps {
				id = <canvas_id>
				texture = white2
				scale = $EG_canvas_scale_factor
				rgba = [255 , 255 , 255 , 0]
			}
		endif
		<done> = 1
	else
		edit_graphic_change_layer_info_value \{change_texture_id = none
			change_texture_name = qs("")
			change_string = qs("")}
		edit_graphic_destroy_image_string
		<done> = 0
	endif
	edit_graphic_update_layer_graphics \{update_all = 0
		index = $EG_current_layer_menu_index}
	edit_graphic_exit_keyboard_menu done = <done> new_text = <new_text>
endscript

script edit_graphic_exit_keyboard_menu \{done = 0}
	destroy_onscreen_keyboard
	SetScreenElementLock \{id = edit_graphic_main_menu_anchor
		off}
	AssignAlias \{id = edit_graphic_main_menu_anchor
		alias = current_menu_anchor}
	edit_graphic_create_helper_text
	SetScreenElementLock \{id = edit_graphic_main_menu_anchor}
	if ScreenElementExists \{id = pause_gradient}
		DestroyScreenElement \{id = pause_gradient}
	endif
	SetScreenElementProps \{id = edit_graphic_main_menu_anchor
		alpha = 1.0
		time = 0.0}
	if (<done> = 1)
		edit_graphic_create_action_menu_anchor menu_type = font_menu new_text = <new_text>
	else
		if (<new_text> = 1)
			edit_graphic_create_action_menu_anchor \{menu_type = category_menu}
			LaunchEvent \{type = pad_up
				target = edit_graphic_category_vmenu}
		else
			edit_graphic_create_action_menu_anchor \{menu_type = tool_menu}
			edit_graphic_highlight_avail_tools \{layer_index = $EG_current_layer_info_index
				menu_index = $EG_current_layer_menu_index}
			LaunchEvent \{type = focus
				target = edit_graphic_tool_vmenu}
		endif
	endif
endscript

script edit_graphic_create_font_menu 
