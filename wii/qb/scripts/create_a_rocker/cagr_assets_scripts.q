			{pad_back edit_graphic_font_menu_exit}
			{pad_up generic_menu_up_or_down_sound params = {up}}
			{pad_down generic_menu_up_or_down_sound params = {down}}
		]
		replace_handlers
		tags = {new_text = <new_text>}
	}
	edit_graphic_add_font_menu_item \{text = qs(0x8db76256)
		id = font_grafitti_1
		index = 0}
	edit_graphic_add_font_menu_item \{text = qs(0xdc892fa9)
		id = font_grafitti_2
		index = 1}
	edit_graphic_add_font_menu_item \{text = qs(0xf0f1bea0)
		id = font_bold
		index = 2}
	edit_graphic_add_font_menu_item \{text = qs(0xfb572ec7)
		id = font_block
		index = 3}
	edit_graphic_add_font_menu_item \{text = qs(0x96c7a9ef)
		id = font_neversoft
		index = 4}
	edit_graphic_add_font_menu_item \{text = qs(0x8d2cbc17)
		id = font_stencil
		index = 5}
	edit_graphic_add_font_menu_item \{text = qs(0x737b08e8)
		id = font_spray
		index = 6}
	edit_graphic_add_font_menu_item \{text = qs(0x4eb3335b)
		id = font_3d
		index = 7}
	edit_graphic_add_font_menu_item \{text = qs("DONE")
		id = font_done
		index = 8
		done = 1}
	LaunchEvent \{type = focus
		target = edit_graphic_font_vmenu}
endscript

