horizontal_flip_id = none
vertical_flip_id = none

script edit_graphic_create_layer_menu 
	if NOT IsTrue \{$CJP_my_menu}
		CreateScreenElement \{type = ContainerElement
			parent = edit_graphic_main_menu_anchor
			id = edit_graphic_layer_menu_anchor
			pos = (30.0, 65.0)
			just = [
				left
				top
			]
			heap = $screen_element_heap}
		if NOT GotParam \{only_preview}
			title_color = [255 255 255 255]
			CreateScreenElement {
				type = TextElement
				parent = edit_graphic_layer_menu_anchor
				id = edit_graphic_layer_menu_title
				font = text_a4
				text = qs(0x425fd283)
				scale = 1.0
				rgba = <title_color>
				pos = (0.0, 0.0)
				just = [left top]
				heap = $screen_element_heap
			}
		endif
		CreateScreenElement \{type = VMenu
			parent = edit_graphic_layer_menu_anchor
			id = edit_graphic_layer_vmenu
			spacing_between = 3
			pos = (0.0, 26.0)
			just = [
				left
				top
			]
			heap = $screen_element_heap}
		SetScreenElementProps \{id = edit_graphic_layer_vmenu
			event_handlers = [
				{
					focus
					edit_graphic_layer_menu_focus
				}
				{
					unfocus
					edit_graphic_layer_menu_unfocus
				}
				{
					pad_back
					generic_menu_pad_back_sound
				}
				{
					pad_back
					edit_graphic_exit_main_menu
				}
				{
					pad_up
					generic_menu_up_or_down_sound
					params = {
						up
					}
				}
				{
					pad_down
					generic_menu_up_or_down_sound
					params = {
						down
					}
				}
			]
			replace_handlers}
		<alpha> = 1
		if GotParam \{only_preview}
			<alpha> = 0
		endif
		edit_graphic_add_layer_menu_item text = qs("1") menu_index = 0 id = layer_menu_01 selected = 1 alpha = <alpha>
		edit_graphic_add_layer_menu_item text = qs("2") menu_index = 1 id = layer_menu_02 alpha = <alpha>
		edit_graphic_add_layer_menu_item text = qs("3") menu_index = 2 id = layer_menu_03 alpha = <alpha>
		edit_graphic_add_layer_menu_item text = qs("4") menu_index = 3 id = layer_menu_04 alpha = <alpha>
		edit_graphic_add_layer_menu_item text = qs("5") menu_index = 4 id = layer_menu_05 alpha = <alpha>
		edit_graphic_add_layer_menu_item text = qs("6") menu_index = 5 id = layer_menu_06 alpha = <alpha>
		edit_graphic_add_layer_menu_item text = qs("7") menu_index = 6 id = layer_menu_07 alpha = <alpha>
		edit_graphic_add_layer_menu_item text = qs("8") menu_index = 7 id = layer_menu_08 alpha = <alpha>
		edit_graphic_add_layer_menu_item text = qs("9") menu_index = 8 id = layer_menu_09 alpha = <alpha>
		edit_graphic_add_layer_menu_item text = qs("10") menu_index = 9 id = layer_menu_10 alpha = <alpha>
		edit_graphic_add_layer_menu_item text = qs("11") menu_index = 9 id = layer_menu_10 alpha = <alpha>
		edit_graphic_add_layer_menu_item text = qs("12") menu_index = 9 id = layer_menu_10 alpha = <alpha>
		edit_graphic_add_layer_menu_item text = qs("13") menu_index = 9 id = layer_menu_10 alpha = <alpha>
		edit_graphic_add_layer_menu_item text = qs("14") menu_index = 9 id = layer_menu_10 alpha = <alpha>
		edit_graphic_add_layer_menu_item text = qs("15") menu_index = 9 id = layer_menu_10 alpha = <alpha>
		edit_graphic_add_layer_menu_item text = qs("Random") menu_index = 10 id = layer_menu_random rand = 1 alpha = <alpha>
		edit_graphic_add_layer_menu_item text = qs(0x0ddb4edc) menu_index = 11 id = layer_menu_done done = 1 alpha = <alpha>
	else
		edit_graphic_get_array_info_vals index = ($EG_current_layer_info_index)
		if ScreenElementExists \{id = cagr_edit_vmenu}
			DestroyScreenElement \{id = cagr_edit_vmenu}
		endif
		make_generic_menu \{vmenu_id = cagr_edit_vmenu
			title = $wii_bandlogo_edit_design
			num_icons = 1
			show_history
			pad_back_script = edit_graphic_create_main_menu}
		add_generic_menu_button_icon_item \{icon = icon_color
			text = $wii_bandlogo_color
			pad_choose_script = edit_graphic_choose_color_menu}
		button_widget_add_item {
			widget_id = Transparency
			text = $wii_bandlogo_transparency
			button_icon = widget_transparency
			min = 0
			max = 255
			start_value = (<hsva> [3])
			step = 8
			pad_up_script = image_transparency
			pad_up_params = {up}
			pad_down_script = image_transparency
			pad_down_params = {down}
			fill_type = `Bottom to Top`
		}
		button_widget_add_item {
			widget_id = scale_width
			text = $wii_bandlogo_width
			button_icon = widget_uni_move
			start_value = <scale_x>
			min = -3.0
			max = 3.0
			step = 0.1
			pad_up_script = scale_image
			pad_up_params = {right}
			pad_down_script = scale_image
			pad_down_params = {left}
			fill_type = `Center Left/Right`
			icon_rot = 90
		}
		button_widget_add_item {
			widget_id = scale_height
			text = $wii_bandlogo_height
			button_icon = widget_uni_move
			start_value = <scale_y>
			min = -3.0
			max = 3.0
			step = 0.1
			pad_up_script = scale_image
			pad_up_params = {up}
			pad_down_script = scale_image
			pad_down_params = {down}
			fill_type = `Center Up/Down`
		}
		button_widget_add_item {
			widget_id = horiz_move
			text = $wii_bandlogo_horizontal
			button_icon = widget_uni_move
			start_value = <pos_x>
			min = -64
			max = 192
			step = 4
			pad_up_script = move_image
			pad_up_params = {horiz}
			pad_down_script = move_image
			pad_down_params = {horiz}
			fill_type = `Center Left/Right`
			icon_rot = 90
		}
		button_widget_add_item {
			widget_id = vert_move
			text = $wii_bandlogo_vertical
			button_icon = widget_uni_move
			start_value = (128 - <pos_y>)
			min = -64
			max = 192
			step = 4
			pad_up_script = move_image
			pad_up_params = {vert}
			pad_down_script = move_image
			pad_down_params = {vert}
			fill_type = `Center Up/Down`
			invert
		}
		button_widget_add_item {
			widget_id = horiz_shear
			text = $wii_bandlogo_lean
			button_icon = widget_uni_move
			start_value = <shear_x>
			min = -2.0
			max = 2.0
			step = 0.1
			pad_up_script = shear_image
			pad_up_params = {up}
			pad_down_script = shear_image
			pad_down_params = {down}
			fill_type = `Center Left/Right`
			icon_rot = 90
		}
		button_widget_add_item {
			widget_id = vert_shear
			text = $wii_bandlogo_tilt
			button_icon = widget_uni_move
			start_value = <shear_y>
			min = -2.0
			max = 2.0
			step = 0.1
			pad_up_script = skew_image
			pad_up_params = {left}
			pad_down_script = skew_image
			pad_down_params = {right}
			fill_type = `Center Up/Down`
		}
		rot_widget_add_item {
			widget_id = rot_widget
			text = $wii_bandlogo_rotate
			button_icon = widget_rotate
			start_value = <rot>
			min = 0
			max = 360
			step = 15
			pad_up_script = rotate_image
			pad_down_script = rotate_image
			fill_type = `Counter Clockwise`
			wrap
			sweep
		}
		if ((<flip_h>) = 1)
			on = true
		else
			on = false
		endif
		add_generic_menu_button_icon_item {
			icon = widget_flip
			text = $wii_bandlogo_flip_horiz
			pad_choose_script = edit_graphic_flip_layer
			pad_choose_params = {horiz = 1}
			icon_rot = 90
			on = <on>
		}
		change horizontal_flip_id = <item_container_id>
		if ((<flip_v>) = 1)
			on = true
		else
			on = false
		endif
		add_generic_menu_button_icon_item {
			icon = widget_flip
			text = $wii_bandlogo_flip_vert
			pad_choose_script = edit_graphic_flip_layer
			pad_choose_params = {vert = 1}
			on = <on>
		}
		change vertical_flip_id = <item_container_id>
		add_generic_menu_icon_item \{icon = widget_default
			text = $wii_bandlogo_default
			pad_choose_script = default_image}
		add_generic_menu_icon_item \{icon = menu_history_unknown
			text = $wii_bandlogo_select_graphic
			pad_choose_script = edit_graphic_create_category_menu
			pad_choose_params = {
				menu_type = category_menu
			}}
		add_generic_menu_icon_item \{icon = widget_flip
			text = $wii_bandlogo_swap_backward
			pad_choose_script = edit_graphic_swap_layers
			pad_choose_params = {
				swap_up = 1
			}
			icon_rot = 0}
		add_generic_menu_icon_item \{icon = widget_flip
			text = $wii_bandlogo_swap_forward
			pad_choose_script = edit_graphic_swap_layers
			pad_choose_params = {
				swap_down = 1
			}
			icon_rot = 180}
		add_generic_menu_icon_item \{icon = icon_copy
			text = $wii_bandlogo_copy_to_open_layer
			pad_choose_script = edit_graphic_copy_to_open_layer}
		add_generic_menu_icon_item \{icon = icon_new
			text = $wii_bandlogo_delete_layer
			pad_choose_script = edit_graphic_check_clear_current_layer}
		LaunchEvent \{type = focus
			target = cagr_edit_vmenu}
		add_user_control_helper \{button = green
			text = $wii_bandlogo_select}
		add_user_control_helper \{button = red
			text = $wii_back}
	endif
endscript

script edit_graphic_choose_color_menu 
	if ScreenElementExists \{id = cagr_edit_color_vmenu}
		DestroyScreenElement \{id = cagr_edit_color_vmenu}
	endif
	make_generic_menu \{vmenu_id = cagr_edit_color_vmenu
		title = $wii_bandlogo_edit_color
		num_icons = 1
		show_history
		pad_back_script = edit_graphic_create_layer_menu}
	AddArrayElement \{array = [
		]
		element = 255}
	AddArrayElement array = <array> element = 255
	AddArrayElement array = <array> element = 255
	rgba = <array>
	colorwheel_add_item {
		scale = 0.6
		pad_choose_script = edit_graphic_choose_color_menu_back
		increment_focus_script = edit_graphic_change_color
		increment_focus_params = {part = <part> cap_index = <cap_index> layer_index = <layer_index>}
		pos = (180.0, 170.0)
		dims = (300.0, 540.0)
		lookup_table = ($default_colorwheel)
		no_background
	}
	LaunchEvent \{type = focus
		target = cagr_edit_color_vmenu}
	LaunchEvent \{type = pad_choose}
	add_user_control_helper \{button = green
		text = $wii_bandlogo_select}
	add_user_control_helper \{button = red
		text = $wii_back}
endscript

script edit_graphic_choose_color_menu_back 
	unfocus_color_wheel
	edit_graphic_create_layer_menu
endscript

script scale_image 
	new_scale_x = ($edit_graphic_layer_infos [$EG_current_layer_info_index].scale_x)
	new_scale_y = ($edit_graphic_layer_infos [$EG_current_layer_info_index].scale_y)
	if GotParam \{up}
		new_scale_y = <value>
	endif
	if GotParam \{down}
		new_scale_y = <value>
	endif
	if GotParam \{right}
		new_scale_x = <value>
	endif
	if GotParam \{left}
		new_scale_x = <value>
	endif
	edit_graphic_change_layer_info_value change_scale_x = <new_scale_x> change_scale_y = <new_scale_y>
	edit_graphic_prepare_sprite_infos
	GenerateCAGTexture info_array = <sprite_infos> player = <currentSkaterProfileIndex> test = 0
endscript

script skew_image 
	edit_graphic_change_layer_info_value change_skew = <value>
	edit_graphic_prepare_sprite_infos
	GenerateCAGTexture info_array = <sprite_infos> player = <currentSkaterProfileIndex> test = 0
endscript

script shear_image 
	edit_graphic_change_layer_info_value change_shear = <value>
	edit_graphic_prepare_sprite_infos
	GenerateCAGTexture info_array = <sprite_infos> player = <currentSkaterProfileIndex> test = 0
endscript

script image_transparency 
	new_transparency = <value>
	CastToInteger \{new_transparency}
	edit_graphic_change_layer_info_value change_a = <new_transparency>
	edit_graphic_prepare_sprite_infos
	GenerateCAGTexture info_array = <sprite_infos> player = <currentSkaterProfileIndex> test = 0
endscript

script rotate_image 
	CastToInteger \{value}
	edit_graphic_change_layer_info_value change_rot = <value>
	edit_graphic_prepare_sprite_infos
	GenerateCAGTexture info_array = <sprite_infos> player = <currentSkaterProfileIndex> test = 0
endscript

script move_image 
	CastToInteger \{value}
	if GotParam \{horiz}
		edit_graphic_change_layer_info_value change_pos_x = <value>
	elseif GotParam \{vert}
		edit_graphic_change_layer_info_value change_pos_y = (128 - <value>)
	endif
	edit_graphic_prepare_sprite_infos
	GenerateCAGTexture info_array = <sprite_infos> player = <currentSkaterProfileIndex> test = 0
endscript

script default_image 
	edit_graphic_change_layer_info_value {change_pos_x = (64)
		change_pos_y = (64)
		change_rot = 0
		change_scale_x = 1.0
		change_scale_y = 1.0
		change_flip_h = 0
		change_flip_v = 0
		change_h = 0
		change_s = 0
		change_v = 60
		change_a = 255
		change_color = none
		change_shear = 0.0
		change_skew = 0.0
	}
	edit_graphic_prepare_sprite_infos
	GenerateCAGTexture info_array = <sprite_infos> player = <currentSkaterProfileIndex> test = 0
endscript

script edit_graphic_add_layer_menu_item \{tab = tab1
		font = text_a4
		icon_scale = 0
		icon_pos = (-120.0, 0.0)
		dims = (80.0, 25.1)
		selected = 0
		done = 0
		rand = 0
		alpha = 1}
	if (<done> = 1)
		<choose_script> = edit_graphic_exit_main_menu
	else
		if (<rand> = 1)
			<choose_script> = edit_graphic_randomize
		else
			<choose_script> = edit_graphic_layer_item_select
		endif
	endif
	<index> = 0
	begin
	if (<menu_index> = ($edit_graphic_layer_infos [<index>].layer_id))
		<layer_info_index> = <index>
	endif
	<index> = (<index> + 1)
	repeat ($edit_graphic_max_layers)
	CreateScreenElement {
		type = ContainerElement
		parent = edit_graphic_layer_vmenu
		dims = <dims>
		event_handlers = [{focus edit_graphic_layer_item_focus params = {id = <id>}}
			{unfocus edit_graphic_layer_item_unfocus params = {id = <id>}}
			{pad_choose generic_menu_pad_choose_sound}
			{pad_choose <choose_script> params = <choose_params>}
			{pad_start <choose_script> params = <choose_params>}
		]
		id = <id>
		just = [left top]
		tags = {layer_info_index = <layer_info_index>
			tag_grid_x = <menu_index>
		}
		z_priority = 1
		heap = $screen_element_heap
		alpha = <alpha>
	}
	<vmenu_item> = <id>
	if (<selected> = 1)
		bar_color = [255 , 255 , 255 , 255]
		<bg_rgba> = <bar_color>
		<bg_texture> = roundbar_middle
		<bg_scale> = (2.5, 0.8)
	else
		<bg_rgba> = [80 , 80 , 80 , 60]
		<bg_texture> = white2
		<bg_scale> = (10.0, 3.1374998)
	endif
	if ((<done> = 0) && (<rand> = 0))
		CreateScreenElement {
			parent = <vmenu_item>
			type = SpriteElement
			texture = <bg_texture>
			rgba = <bg_rgba>
			scale = <bg_scale>
			pos = (0.0, 0.0)
			just = [left top]
			z_priority = 2
			heap = $screen_element_heap
		}
		GetScreenElementPosition id = <id>
		GetScreenElementDims id = <id>
		right_edge = (<width> * (1.0, 0.0))
		offset = (-4.0, 3.0)
		<vmenu_item> :SetTags right_edge = <right_edge> width = <width> offset = <offset> override_scale = <override_scale>
		CreateScreenElement {
			parent = <vmenu_item>
			type = SpriteElement
			texture = white2
			rgba = [0 , 0 , 0 , 255]
			scale = 6
			pos = (46.0, 0.0)
			just = [left top]
			z_priority = 3
			heap = $screen_element_heap
		}
		CreateScreenElement {
			parent = <id>
			type = SpriteElement
			texture = white2
			rgba = [20 , 20 , 20 , 255]
			scale = 6
			pos = (1.0, 1.0)
			just = [left top]
			z_priority = 4
			heap = $screen_element_heap
		}
		CreateScreenElement {
			parent = <vmenu_item>
			type = SpriteElement
			texture = white2
			scale = $EG_thumb_scale
			pos = $EG_thumb_pos
			just = [left top]
			z_priority = 5
			heap = $screen_element_heap
		}
		CreateScreenElement {
			type = SpriteElement
			parent = <vmenu_item>
			local_id = roundbar_highlight
			sacle = <bg_scale>
			texture = roundbar_highlight
			pos = (0.0, 0.0)
			rgba = [255 , 255 , 255 , 0]
			just = [left top]
			z_priority = 2.5
			heap = $screen_element_heap
		}
	endif
	if (<done> = 1)
		<z_priority> = 200
		<pos> = (0.0, 5.0)
	else
		<z_priority> = 3
		if (<rand> = 1)
			<pos> = (0.0, 2.0)
		else
			<pos> = (5.0, 2.0)
		endif
	endif
	CreateScreenElement {
		type = TextElement
		parent = <vmenu_item>
		local_id = text
		font = <font>
		text = <text>
		rgba = [90 90 90 90]
		just = [left top]
		pos = <pos>
		z_priority = <z_priority>
		shadow
		shadow_rgba = $UI_text_shadow_color
		shadow_offs = $UI_text_shadow_offset
		heap = $screen_element_heap
	}
endscript

script edit_graphic_layer_menu_focus 
	SetScreenElementProps \{id = edit_graphic_layer_menu_title
		rgba = [
			255
			255
			255
			255
		]}
endscript

script edit_graphic_layer_menu_unfocus 
	title_color = [255 255 255 255]
	SetScreenElementProps {
		id = edit_graphic_layer_menu_title
		rgba = <title_color>
	}
endscript

script edit_graphic_layer_item_focus 
	bar_color = [255 255 255 255]
	GetTags
	if NOT (<tag_grid_x> > 9)
		SetScreenElementProps {
			id = {<id> child = 0}
			texture = roundbar_middle
			rgba = <bar_color>
		}
		SetScreenElementProps id = {<id> child = 0} scale = (2.5, 0.8) time = 0
		RunScriptOnScreenElement id = {<id> child = roundbar_highlight} edit_CAG_menu_highlight params = {width = <width> right_edge = <right_edge> offset = <offset> override_scale = <override_scale>}
		<text_rgba> = [123 4 93 255]
	else
		<text_rgba> = [255 , 255 , 255 , 255]
	endif
	SetScreenElementProps {
		id = {<id> child = text}
		rgba = <text_rgba>
	}
	edit_graphic_highlight_avail_tools layer_index = <layer_info_index> menu_index = <tag_grid_x>
endscript

script edit_graphic_layer_item_unfocus 
	GetTags
	if NOT (<tag_grid_x> > 9)
		SetScreenElementProps {
			id = {<id> child = 0}
			rgba = [80 , 80 , 80 , 60]
			texture = white2
		}
		SetScreenElementProps id = {<id> child = 0} scale = (10.0, 3.1374998) time = 0
		KillSpawnedScript \{name = edit_CAG_menu_highlight}
		SetScreenElementProps id = {<id> child = roundbar_highlight} alpha = 0 time = 0
	endif
	SetScreenElementProps {
		id = {<id> child = text}
		rgba = [90 , 90 , 90 , 90]
	}
endscript

script edit_graphic_layer_item_select 
	if NOT IsTrue \{$CJP_my_menu}
		edit_graphic_layer_vmenu :GetTags
		change EG_current_layer_menu_index = <tag_selected_index>
		GetTags
		change EG_current_layer_info_index = <layer_info_index>
		LaunchEvent \{type = unfocus
			target = edit_graphic_layer_vmenu}
		LaunchEvent \{type = focus
			target = edit_graphic_tool_vmenu
			data = {
				grid_index = 0
			}}
		rgba = [255 255 255 255]
		SetScreenElementProps {
			id = {<tag_selected_id> child = 0}
			rgba = <rgba>
			texture = roundbar_middle
		}
		SetScreenElementProps id = {<tag_selected_id> child = 0} scale = (2.5, 0.8) time = 0
		SetScreenElementProps {
			id = {<tag_selected_id> child = text}
			rgba = [100 , 100 , 100 , 255]
		}
	else
		change EG_current_layer_info_index = <my_layer>
		if GotParam \{new}
			edit_graphic_create_category_menu
		else
			edit_graphic_create_layer_menu
		endif
	endif
endscript

script edit_graphic_update_layer_graphics \{update_all = 1}
	if IsTrue \{$CJP_my_menu}
		if NOT GetScreenElementChildren \{id = cagr_edit_vmenu}
			printf \{qs(0x6bafad13)}
			return
		endif
		GetArraySize ($edit_graphic_layer_infos)
		if (<array_size> <= 0)
			change edit_graphic_layer_infos = ($default_graphic_layer_info)
		endif
		<layer_info_index> = $EG_current_layer_menu_index
	else
		if NOT GetScreenElementChildren \{id = edit_graphic_layer_vmenu}
			printf \{qs(0x6bafad13)}
			return
		endif
	endif
	if (<update_all> = 1)
		GetArraySize <children>
		<menu_index> = 0
	else
		<array_size> = 3
		<menu_index> = <index>
	endif
	begin
	<menu_item> = (<children> [<menu_index>])
	<menu_item> :GetTags
	if (($edit_graphic_layer_infos [<layer_info_index>].texture_id) = none)
		if (($edit_graphic_layer_infos [<layer_info_index>].string) = qs(""))
			<thumb_texture> = white2
			<thumb_scale> = $EG_thumb_scale
			<thumb_pos> = $EG_thumb_pos
			<thumb_rgba> = [255 , 255 , 255 , 0]
			<canvas_scale> = $EG_canvas_scale_factor
			<canvas_rgba> = [255 , 255 , 255 , 0]
			<offset> = (0.0, 0.0)
		else
			edit_graphic_destroy_image_string use_current = 0 info_index = <layer_info_index>
			edit_graphic_build_image_string info_index = <layer_info_index> menu_index = <menu_index>
			edit_graphic_get_thumb_texture info_index = <layer_info_index>
			<thumb_texture> = <thumb_texture>
			<thumb_scale> = (0.29, 0.29)
			<thumb_pos> = (52.0, 3.0)
			HSVtoRGB hsv = ($edit_graphic_layer_infos [<layer_info_index>].hsva)
			<thumb_rgba> = <rgb>
			<canvas_scale> = (($edit_graphic_layer_infos [<layer_info_index>].scale) * $EG_canvas_scale_factor)
			<canvas_rgba> = [255 , 255 , 255 , 0]
			<offset> = (((1.0, 0.0) * ((8 * <canvas_scale>) / 2)) + ((0.0, 1.0) * ((8 * <canvas_scale>) / 2)))
		endif
		<canvas_texture> = white2
	else
		<thumb_texture> = ($edit_graphic_layer_infos [<layer_info_index>].texture_id)
		<thumb_scale> = $EG_thumb_scale
		<thumb_pos> = $EG_thumb_pos
		HSVtoRGB hsv = ($edit_graphic_layer_infos [<layer_info_index>].hsva)
		<thumb_rgba> = <rgb>
		<canvas_texture> = ($edit_graphic_layer_infos [<layer_info_index>].texture_id)
		<canvas_scale> = (($edit_graphic_layer_infos [<layer_info_index>].scale) * $EG_canvas_scale_factor)
		<canvas_rgba> = <rgb>
		<offset> = (0.0, 0.0)
	endif
	if (($edit_graphic_layer_infos [<layer_info_index>].flip_v) = 1)
		<flipv> = flip_h
	endif
	if (($edit_graphic_layer_infos [<layer_info_index>].flip_h) = 1)
		<fliph> = flip_v
	endif
	SetScreenElementProps {
		id = {<menu_item> child = 2}
		texture = <thumb_texture>
		rgba = <thumb_rgba>
		pos = <thumb_pos>
	}
	SetScreenElementProps id = {<menu_item> child = 2} scale = <thumb_scale> time = 0
	<canvas_id> = ($edit_graphic_layer_infos [<layer_info_index>].canvas_id)
	<rot_angle> = ($edit_graphic_layer_infos [<layer_info_index>].rot)
	<pos_x> = ($edit_graphic_layer_infos [<layer_info_index>].pos_x)
	<pos_y> = ($edit_graphic_layer_infos [<layer_info_index>].pos_y)
	<pos> = (((1.0, 0.0) * <pos_x>) + ((0.0, 1.0) * <pos_y>))
	<pos> = (<pos> * 2.875)
	if NOT IsTrue \{$CJP_my_menu}
		if NOT (<canvas_id> = none)
			SetScreenElementProps {
				id = <canvas_id>
				texture = <canvas_texture>
				z_priority = ($EG_canvas_base_z + <menu_index>)
				rot_angle = <rot_angle>
				pos = (<pos> + <offset>)
				rgba = <canvas_rgba>
				<flipv>
				<fliph>
				just = [center center]
				internal_just = [center center]
			}
			SetScreenElementProps id = <canvas_id> scale = <canvas_scale> time = 0
		else
			ScriptAssert \{qs(0xb48e909a)}
		endif
	endif
	<menu_index> = (<menu_index> + 1)
	RemoveParameter \{layer_info_index}
	RemoveParameter \{flipv}
	RemoveParameter \{fliph}
	repeat (<array_size> -2)
endscript

script edit_graphic_get_thumb_texture 
	<layer_string> = ($edit_graphic_layer_infos [<info_index>].string)
	StringToCharArray string = <layer_string>
	GetArraySize <char_array>
	<font> = (EG_font_names [($edit_graphic_layer_infos [<info_index>].font_id)].name)
	<index> = 0
	begin
	if NOT ((<char_array> [<index>]) = qs(" "))
		<char> = (<char_array> [<index>])
		break
	endif
	<index> = (<index> + 1)
	repeat <array_size>
	FormatText checksumname = texture qs(0x00f937a4) f = <font> l = <char>
	return thumb_texture = <texture>
endscript

script edit_graphic_highlight_avail_tools \{tools_in_focus = 0}
	GetScreenElementChildren \{id = edit_graphic_tool_vmenu}
	off_color = [255 255 255 255]
	if (<menu_index> > 9)
		<rgba> = $EG_unselectable_text_color
		<is_selectable> = not_focusable
		SetScreenElementProps {
			id = {(<children> [0]) child = 0}
			rgba = $EG_unselectable_text_color
		}
	else
		if ((($edit_graphic_layer_infos [<layer_index>].texture_id) = none) && (($edit_graphic_layer_infos [<layer_index>].string) = qs("")))
			<rgba> = $EG_unselectable_text_color
			<is_selectable> = not_focusable
		else
			<rgba> = (<off_color>)
			<is_selectable> = focusable
		endif
		if (<tools_in_focus> = 0)
			SetScreenElementProps {
				id = {(<children> [0]) child = 0}
				rgba = (<off_color>)
			}
		endif
	endif
	GetArraySize <children>
	<child_index> = 1
	begin
	if ((<child_index> < 8) || (<child_index> > 9))
		SetScreenElementProps {
			id = {(<children> [<child_index>]) child = 0}
			rgba = <rgba>
		}
	endif
	SetScreenElementProps {
		id = (<children> [<child_index>])
		<is_selectable>
	}
	<child_index> = (<child_index> + 1)
	repeat (<array_size> - 1)
	if NOT (<menu_index> > 9)
		if (<menu_index> = 0)
			SetScreenElementProps \{id = swap_backward
				not_focusable}
			SetScreenElementProps \{id = {
					swap_backward
					child = 0
				}
				rgba = $EG_unselectable_text_color}
		else
			if (<menu_index> = 9)
				SetScreenElementProps \{id = swap_forward
					not_focusable}
				SetScreenElementProps \{id = {
						swap_forward
						child = 0
					}
					rgba = $EG_unselectable_text_color}
			endif
		endif
		if NOT (($edit_graphic_layer_infos [<layer_index>].string) = qs(""))
			SetScreenElementProps {
				id = (<children> [0])
				event_handlers = [{focus edit_graphic_tool_item_focus params = {id = (<children> [0]) index = 0}}
					{unfocus edit_graphic_tool_item_unfocus params = {id = (<children> [0]) index = 0}}
					{pad_choose generic_menu_pad_choose_sound}
					{pad_choose edit_graphic_create_action_menu_anchor params = {menu_type = keyboard_menu new_text = 0}}
					{pad_start null_script}
				]
				replace_handlers
			}
			SetScreenElementProps {
				id = {(<children> [0]) child = 0}
				text = $wii_bandlogo_modify_text
			}
		else
			SetScreenElementProps {
				id = (<children> [0])
				event_handlers = [{focus edit_graphic_tool_item_focus params = {id = (<children> [0]) index = 0}}
					{unfocus edit_graphic_tool_item_unfocus params = {id = (<children> [0]) index = 0}}
					{pad_choose generic_menu_pad_choose_sound}
					{pad_choose edit_graphic_create_action_menu_anchor params = {menu_type = category_menu}}
					{pad_start null_script}
				]
				replace_handlers
			}
			SetScreenElementProps {
				id = {(<children> [0]) child = 0}
				text = $wii_bandlogo_select_graphic
			}
		endif
		if NOT (($edit_graphic_layer_infos [<layer_index>].string) = qs(""))
			SetScreenElementProps \{id = flip_horizontally
				not_focusable}
			SetScreenElementProps \{id = {
					flip_horizontally
					child = 0
				}
				rgba = $EG_unselectable_text_color}
			SetScreenElementProps \{id = flip_vertically
				rgba = $EG_unselectable_text_color
				not_focusable}
			SetScreenElementProps \{id = {
					flip_vertically
					child = 0
				}
				rgba = $EG_unselectable_text_color}
		endif
		edit_graphic_set_copy_tool layer_index = <layer_index>
	endif
endscript

script edit_graphic_set_copy_tool 
	<layer_available> = 0
	<index> = 0
	begin
	if ((($edit_graphic_layer_infos [<index>].texture_id) = none) && (($edit_graphic_layer_infos [<index>].string) = qs("")))
		<layer_available> = 1
		break
	endif
	<index> = (<index> + 1)
	repeat ($edit_graphic_max_layers)
	if ((($edit_graphic_layer_infos [<layer_index>].texture_id) = none) && (($edit_graphic_layer_infos [<layer_index>].string) = qs("")))
		<rgba> = $EG_unselectable_text_color
		<is_selectable> = not_focusable
	else
		edit_graphic_tool_vmenu :GetTags
		if (<layer_available>)
			rgba = [255 255 255 255]
			<is_selectable> = focusable
		else
			if (<tag_selected_index> = 7)
				begin
				LaunchEvent \{type = pad_down
					target = edit_graphic_tool_vmenu}
				repeat 7
			endif
			<rgba> = $EG_unselectable_text_color
			<is_selectable> = not_focusable
		endif
	endif
	SetScreenElementProps {
		id = copy_to_open_layer
		<is_selectable>
	}
	SetScreenElementProps {
		id = {copy_to_open_layer child = 0}
		rgba = <rgba>
	}
endscript

script edit_graphic_create_action_menu_anchor \{bg_texture = white2}
	if NOT IsTrue \{$CJP_my_menu}
		SetScreenElementLock \{id = edit_graphic_main_menu_anchor
			off}
		if ObjectExists \{id = edit_graphic_action_menu_anchor}
			DestroyScreenElement \{id = edit_graphic_action_menu_anchor}
		endif
		CreateScreenElement \{type = ContainerElement
			parent = edit_graphic_main_menu_anchor
			id = edit_graphic_action_menu_anchor
			pos = (118.0, 65.0)
			just = [
				left
				top
			]
			heap = $screen_element_heap}
		switch <menu_type>
			case tool_menu
			edit_graphic_create_tool_menu
			case category_menu
			edit_graphic_create_category_menu
			case image_menu
			edit_graphic_create_image_menu category = <category> index = <index>
			case keyboard_menu
			edit_graphic_create_keyboard_menu new_text = <new_text>
			case font_menu
			edit_graphic_create_font_menu new_text = <new_text>
		endswitch
		SetScreenElementLock \{id = edit_graphic_main_menu_anchor}
	else
		edit_graphic_create_pre_menu
	endif
endscript

script edit_graphic_create_tool_menu 
	title_color = [255 0 0 255]
	CreateScreenElement {
		type = TextElement
		parent = edit_graphic_action_menu_anchor
		id = edit_graphic_tool_menu_title
		font = text_a4
		text = $wii_bandlogo_tools
		scale = 1.1
		rgba = <title_color>
		pos = (286.0, 0.0)
		just = [left top]
		shadow
		shadow_rgba = $UI_text_shadow_color
		shadow_offs = $UI_text_shadow_offset
		heap = $screen_element_heap
	}
	CreateScreenElement \{type = VMenu
		parent = edit_graphic_action_menu_anchor
		id = edit_graphic_tool_vmenu
		padding_scale = 0.95
		pos = (212.0, 30.0)
		just = [
			left
			top
		]
		heap = $screen_element_heap}
	SetScreenElementProps \{id = edit_graphic_tool_vmenu
		event_handlers = [
			{
				focus
				edit_graphic_tool_menu_focus
			}
			{
				unfocus
				edit_graphic_tool_menu_unfocus
			}
			{
				pad_back
				generic_menu_pad_back_sound
			}
			{
				pad_back
				edit_graphic_tool_menu_back
			}
			{
				pad_up
				generic_menu_up_or_down_sound
				params = {
					up
				}
			}
			{
				pad_down
				generic_menu_up_or_down_sound
				params = {
					down
				}
			}
		]
		replace_handlers}
	edit_graphic_add_tool_menu_item \{text = $wii_bandlogo_select_graphic
		index = 0
		id = select_layer
		choose_script = edit_graphic_create_action_menu_anchor
		params = {
			menu_type = category_menu
		}}
	edit_graphic_add_tool_menu_item \{text = $wii_bandlogo_erase_layer
		index = 1
		id = erase_layer
		choose_script = edit_graphic_erase_layer_dialog}
	edit_graphic_add_tool_menu_item \{text = $wii_bandlogo_transform_layer
		index = 2
		id = transform_layer
		choose_script = edit_graphic_create_transform_menu}
	edit_graphic_add_tool_menu_item \{text = $wii_bandlogo_flip_h
		index = 3
		id = flip_horizontally
		choose_script = edit_graphic_flip_layer
		params = {
			horiz = 1
		}}
	edit_graphic_add_tool_menu_item \{text = $wii_bandlogo_flip_v
		index = 4
		id = flip_vertically
		choose_script = edit_graphic_flip_layer
		params = {
			vert = 1
		}}
	edit_graphic_add_tool_menu_item \{text = $wii_bandlogo_swap_backward
		index = 5
		id = swap_backward
		choose_script = edit_graphic_swap_layers
		params = {
			swap_up = 1
		}}
	edit_graphic_add_tool_menu_item \{text = $wii_bandlogo_swap_forward
		index = 6
		id = swap_forward
		choose_script = edit_graphic_swap_layers
		params = {
			swap_down = 1
		}}
	edit_graphic_add_tool_menu_item \{text = $wii_bandlogo_copy_to_open_layer
		index = 7
		id = copy_to_open_layer
		choose_script = edit_graphic_copy_to_open_layer}
	edit_graphic_add_color_swatches \{menu_id = edit_graphic_color_hmenu1
		color_index = 0}
	edit_graphic_add_color_swatches \{menu_id = edit_graphic_color_hmenu2
		color_index = 8}
endscript

script edit_graphic_add_tool_menu_item \{choose_script = null_script}
	CreateScreenElement {
		type = ContainerElement
		parent = edit_graphic_tool_vmenu
		id = <id>
		dims = (200.0, 20.0)
		event_handlers = [{focus edit_graphic_tool_item_focus params = {id = <id> index = <index>}}
			{unfocus edit_graphic_tool_item_unfocus params = {id = <id> index = <index>}}
			{pad_choose generic_menu_pad_choose_sound}
			{pad_choose <choose_script> params = <params>}
			{pad_start null_script}
		]
		tags = {tag_grid_x = <index>}
		internal_just = [center center]
		heap = $screen_element_heap
	}
	<container_id> = <id>
	CreateScreenElement {
		type = TextElement
		parent = <container_id>
		font = text_a4
		text = <text>
		scale = 0.675
		rgba = [156 , 156 , 156 , 255]
		z_priority = 3
		just = [center top]
		pos = (102.0, 0.0)
		shadow
		shadow_rgba = $UI_text_shadow_color
		shadow_offs = $UI_text_shadow_offset
		heap = $screen_element_heap
	}
	CreateScreenElement {
		type = SpriteElement
		parent = <container_id>
		pos = (-22.0, -3.0)
		just = [left top]
		scale = (1.0, 0.75)
		texture = roundbar_tip_left
		z_priority = 2
		rgba = [0 0 0 0]
		heap = $screen_element_heap
	}
	CreateScreenElement {
		type = SpriteElement
		parent = <container_id>
		pos = (10.0, -3.0)
		just = [left top]
		scale = (6.0, 0.75)
		texture = roundbar_middle
		z_priority = 2
		rgba = [0 0 0 0]
		heap = $screen_element_heap
	}
	GetScreenElementPosition id = <id>
	GetScreenElementDims id = <id>
	offset = (18.0, -2.0)
	<container_id> :SetTags right_edge = <right_edge> width = <width> offset = <offset> override_scale = <override_scale>
	CreateScreenElement {
		type = SpriteElement
		parent = <container_id>
		pos = (196.0, -3.0)
		just = [left top]
		scale = (1.0, 0.75)
		texture = roundbar_tip_right
		z_priority = 2
		rgba = [0 0 0 0]
		heap = $screen_element_heap
	}
	CreateScreenElement {
		type = SpriteElement
		parent = <container_id>
		local_id = roundbar_highlight
		sacle = <bg_scale>
		texture = roundbar_highlight
		pos = (24.0, -3.0)
		rgba = [255 , 255 , 255 , 0]
		just = [left top]
		z_priority = 2.5
		heap = $screen_element_heap
	}
endscript

script edit_CAG_menu_highlight \{offset = (0.0, 0.0)
		override_scale = 0.9
		width = 0}
	Obj_GetID
	id = <ObjID>
	bar_color = [255 255 255 255]
	SetScreenElementProps {
		id = <id>
		rgba = <bar_color>
	}
	start_pos = ((0.0, 0.0) + <offset>)
	end_pos = ((1.0, 0.0) * <width> + <offset>)
	SetScreenElementProps {
		id = <id>
		pos = (<start_pos>)
	}
	SetScreenElementProps id = <id> scale = <override_scale> time = 0
	SetScreenElementProps id = <id> alpha = 1 time = 0
	SetScreenElementProps id = <id> pos = (<end_pos>) time = 0.35000002
	SetScreenElementProps id = <id> alpha = 0.2 time = 0.4
	Wait \{0.4
		seconds}
	the_width = <width>
	SetScreenElementProps id = <id> scale = (<width> * (0.06, 0.0) + <override_scale> * (0.0, 1.0)) time = 0
	GetScreenElementDims id = <id>
	new_xoff = ((<the_width> - <width>) * 0.5)
	SetScreenElementProps {
		id = <id>
		pos = (<new_xoff> * (1.0, 0.0) + <offset>)
	}
	begin
	SetScreenElementProps id = <id> alpha = 1 time = 0.3
	Wait \{0.3
		seconds}
	SetScreenElementProps id = <id> alpha = 0 time = 0.3
	Wait \{0.3
		seconds}
	repeat
endscript

script edit_graphic_tool_menu_back 
	LaunchEvent \{type = unfocus
		target = edit_graphic_tool_vmenu}
	LaunchEvent \{type = focus
		target = edit_graphic_layer_vmenu}
endscript

script edit_graphic_tool_menu_focus 
	SetScreenElementProps \{id = edit_graphic_tool_menu_title
		rgba = [
			255
			255
			255
			255
		]}
endscript

script edit_graphic_tool_menu_unfocus 
	title_color = [255 255 255 255]
	SetScreenElementProps {
		id = edit_graphic_tool_menu_title
		rgba = <title_color>
	}
endscript

script edit_graphic_tool_item_focus 
	GetTags
	if NOT GotParam \{id}
		ScriptAssert \{qs(0x178054d0)}
	endif
	bar_color = [255 255 255 255]
	on_color = [255 255 255 255]
	SetScreenElementProps {
		id = {<id> child = 0}
		rgba = <on_color>
		shadow_rgba = [255 , 255 , 255 , 0]
	}
	SetScreenElementProps id = {<id> child = 0} time = 0.05 scale = 0.75
	SetScreenElementProps {
		id = {<id> child = 1}
		rgba = <bar_color>
	}
	SetScreenElementProps {
		id = {<id> child = 2}
		rgba = <bar_color>
	}
	SetScreenElementProps {
		id = {<id> child = 3}
		rgba = <bar_color>
	}
	RunScriptOnScreenElement id = {<id> child = roundbar_highlight} edit_CAG_menu_highlight params = {width = <width> right_edge = <right_edge> offset = <offset> override_scale = <override_scale>}
endscript

script edit_graphic_tool_item_unfocus 
	GetTags
	off_color = [255 255 255 255]
	bar_color = [255 255 255 255]
	SetScreenElementProps {
		id = {<id> child = 0}
		rgba = <off_color>
		shadow_rgba = $UI_text_shadow_color
	}
	SetScreenElementProps id = {<id> child = 0} time = 0.05 scale = 0.675
	SetScreenElementProps {
		id = {<id> child = 1}
		rgba = [255 , 255 , 255 , 0]
	}
	SetScreenElementProps {
		id = {<id> child = 2}
		rgba = [255 , 255 , 255 , 0]
	}
	SetScreenElementProps {
		id = {<id> child = 3}
		rgba = [255 , 255 , 255 , 0]
	}
	KillSpawnedScript \{name = edit_CAG_menu_highlight}
	SetScreenElementProps id = {<id> child = roundbar_highlight} alpha = 0 time = 0
endscript

script edit_graphic_add_color_swatches 
	switch <menu_id>
		case edit_graphic_color_hmenu1
		<dims> = (210.0, 80.0)
		case edit_graphic_color_hmenu2
		<dims> = (210.0, 65.0)
	endswitch
	CreateScreenElement {
		type = HMenu
		parent = edit_graphic_tool_vmenu
		id = <menu_id>
		regular_space_amount = 27
		dims = <dims>
		just = [left top]
		heap = $screen_element_heap
	}
	SetScreenElementProps {
		id = <menu_id>
		event_handlers = [{focus edit_graphic_color_swatch_menu_focus params = {menu_id = <menu_id>}}
			{pad_left generic_menu_up_or_down_sound params = {up}}
			{pad_right generic_menu_up_or_down_sound params = {down}}
		]
		replace_handlers
	}
	edit_graphic_add_color_swatch parent_id = <menu_id> color_index = <color_index> menu_index = 0
	<color_index> = (<color_index> + 1)
	edit_graphic_add_color_swatch parent_id = <menu_id> color_index = <color_index> menu_index = 1
	<color_index> = (<color_index> + 1)
	edit_graphic_add_color_swatch parent_id = <menu_id> color_index = <color_index> menu_index = 2
	<color_index> = (<color_index> + 1)
	edit_graphic_add_color_swatch parent_id = <menu_id> color_index = <color_index> menu_index = 3
	<color_index> = (<color_index> + 1)
	edit_graphic_add_color_swatch parent_id = <menu_id> color_index = <color_index> menu_index = 4
	<color_index> = (<color_index> + 1)
	edit_graphic_add_color_swatch parent_id = <menu_id> color_index = <color_index> menu_index = 5
	<color_index> = (<color_index> + 1)
	edit_graphic_add_color_swatch parent_id = <menu_id> color_index = <color_index> menu_index = 6
	<color_index> = (<color_index> + 1)
	edit_graphic_add_color_swatch parent_id = <menu_id> color_index = <color_index> menu_index = 7
endscript

script edit_graphic_add_color_swatch 
	CreateScreenElement {
		parent = <parent_id>
		type = ContainerElement
		pos = (0.0, 0.0)
		just = [left top]
		event_handlers = [{focus edit_graphic_color_swatch_focus params = {menu = <parent_id> index = <menu_index>}}
			{unfocus edit_graphic_color_swatch_unfocus params = {menu = <parent_id> index = <menu_index>}}
			{pad_choose generic_menu_pad_choose_sound}
			{pad_choose edit_graphic_color_swatch_select params = {color_index = <color_index>}}
		]
		tags = {color_index = <color_index>}
		heap = $screen_element_heap
	}
	<container_id> = <id>
	CreateScreenElement {
		parent = <container_id>
		type = SpriteElement
		texture = white2
		rgba = [32 , 32 , 32 , 255]
		scale = (3.0, 3.0)
		z_priority = 2
		heap = $screen_element_heap
	}
	CreateScreenElement {
		parent = <container_id>
		type = SpriteElement
		texture = white2
		rgba = ($EG_color_swatch_values [<color_index>])
		scale = (2.0, 2.2)
		pos = (-8.0, -9.0)
		just = [left top]
		z_priority = 3
		not_focusable
		heap = $screen_element_heap
	}
endscript
EG_color_swatch_menu_selection = 0

script edit_graphic_color_swatch_menu_focus 
	<menu_id> :GetTags
	if NOT (<tag_selected_index> = $EG_color_swatch_menu_selection)
		if (<tag_selected_index> > $EG_color_swatch_menu_selection)
			<num_pads> = (<tag_selected_index> - $EG_color_swatch_menu_selection)
			<pad_event> = pad_left
		else
			<num_pads> = ($EG_color_swatch_menu_selection - <tag_selected_index>)
			<pad_event> = pad_right
		endif
		Wait \{1
			gameframe}
		begin
		LaunchEvent type = <pad_event> target = <menu_id>
		repeat <num_pads>
	endif
endscript

script edit_graphic_color_swatch_focus 
	rgba = [255 255 255 255]
	RunScriptOnScreenElement id = {<menu> child = {<index> child = 0}} edit_graphic_image_focus_glow
	SetScreenElementProps {
		id = {<menu> child = {<index> child = 0}}
		rgba = <rgba>
	}
	change EG_color_swatch_menu_selection = <index>
endscript

script edit_graphic_color_swatch_unfocus 
	KillSpawnedScript \{name = edit_graphic_image_focus_glow}
	SetScreenElementProps {
		id = {<menu> child = {<index> child = 0}}
		time = 0
		rgba = [32 , 32 , 32 , 255]
		alpha = 1
	}
endscript

script edit_graphic_color_swatch_select 
	RGBtoHSV rgb = ($EG_color_swatch_values [<color_index>])
	edit_graphic_change_layer_info_value {
		change_h = (<hsv> [0])
		change_s = (<hsv> [1])
		change_v = (<hsv> [2])
		change_a = (<hsv> [3])
	}
	edit_graphic_update_layer_graphics \{update_all = 0
		index = $EG_current_layer_menu_index}
endscript

script edit_graphic_add_color_sliders 
	AssignAlias \{id = edit_graphic_tool_vmenu
		alias = current_menu}
	colormenu_add_options_to_menu \{part = Board
		from_caf
		text_pos = (-95.0, 21.0)
		icon_pos = (20.0, 21.0)
		arrow_pos_up = (5.0, 27.0)
		arrow_pos_down = (5.0, 13.0)}
endscript

script edit_graphic_increment_hue 
	<h> = ($edit_graphic_layer_infos [$EG_current_layer_info_index].hsva [0])
	<h> = (<h> + 5)
	if (<h> > 359)
		<h> = (<h> - 360)
	endif
	edit_graphic_change_layer_info_value change_h = <h>
	edit_graphic_update_color_arrows
	edit_graphic_update_layer_graphics \{update_all = 0
		index = $EG_current_layer_menu_index}
endscript

script edit_graphic_decrement_hue 
	<h> = ($edit_graphic_layer_infos [$EG_current_layer_info_index].hsva [0])
	<h> = (<h> - 5)
	if (<h> < 0)
		<h> = (<h> + 360)
	endif
	edit_graphic_change_layer_info_value change_h = <h>
	edit_graphic_update_color_arrows
	edit_graphic_update_layer_graphics \{update_all = 0
		index = $EG_current_layer_menu_index}
endscript

script edit_graphic_increment_saturation 
	<s> = ($edit_graphic_layer_infos [$EG_current_layer_info_index].hsva [1])
	<s> = (<s> + 3)
	if (<s> > 90)
		<s> = 90
	endif
	edit_graphic_change_layer_info_value change_s = <s>
	edit_graphic_update_color_arrows
	edit_graphic_update_layer_graphics \{update_all = 0
		index = $EG_current_layer_menu_index}
endscript

script edit_graphic_decrement_saturation 
	<s> = ($edit_graphic_layer_infos [$EG_current_layer_info_index].hsva [1])
	<s> = (<s> - 3)
	if (<s> < 0)
		<s> = 0
	endif
	edit_graphic_change_layer_info_value change_s = <s>
	edit_graphic_update_color_arrows
	edit_graphic_update_layer_graphics \{update_all = 0
		index = $EG_current_layer_menu_index}
endscript

script edit_graphic_increment_value 
	<v> = ($edit_graphic_layer_infos [$EG_current_layer_info_index].hsva [2])
	<v> = (<v> + 2)
	if (<v> > 60)
		<v> = 60
	endif
	edit_graphic_change_layer_info_value change_v = <v>
	edit_graphic_update_color_arrows
	edit_graphic_update_layer_graphics \{update_all = 0
		index = $EG_current_layer_menu_index}
endscript

script edit_graphic_decrement_value 
	<v> = ($edit_graphic_layer_infos [$EG_current_layer_info_index].hsva [2])
	<v> = (<v> - 2)
	if (<v> < 0)
		<v> = 0
	endif
	edit_graphic_change_layer_info_value change_v = <v>
	edit_graphic_update_color_arrows
	edit_graphic_update_layer_graphics \{update_all = 0
		index = $EG_current_layer_menu_index}
endscript

script edit_graphic_increment_alpha 
	<a> = ($edit_graphic_layer_infos [$EG_current_layer_info_index].hsva [3])
	<a> = (<a> + 4)
	if (<a> > 255)
		<a> = 255
	endif
	edit_graphic_change_layer_info_value change_a = <a>
	edit_graphic_update_color_arrows
	edit_graphic_update_layer_graphics \{update_all = 0
		index = $EG_current_layer_menu_index}
endscript

script edit_graphic_decrement_alpha 
	<a> = ($edit_graphic_layer_infos [$EG_current_layer_info_index].hsva [3])
	<a> = (<a> - 4)
	if (<a> < 0)
		<a> = 0
	endif
	edit_graphic_change_layer_info_value change_a = <a>
