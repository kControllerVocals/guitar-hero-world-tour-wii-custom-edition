script ui_init_cagr 
endscript

script ui_create_cagr 
	if IsNgc
		MemPushContext \{TopDownHeap}
	endif
	LoadPak \{'pak\\cagr\\cagr_full_set.pak'
		heap = BottomUpHeap}
	LoadPak \{'pak\\cagr\\cagr_bink_set.pak'
		heap = heap_bink}
	edit_graphic_launch_cagr
endscript

script edit_graphic_leave_flow 
	get_current_band_info
	GetGlobalTags <band_info> param = band_logo
	if GotParam \{band_logo}
		SetGlobalTags <band_info> params = {band_logo = ($edit_graphic_layer_infos)}
		ui_memcard_autosave_replace \{event = menu_back}
	endif
endscript

script ui_destroy_cagr 
	if IsNgc
		MemPopContext
	endif
	UnloadPak \{'pak\\cagr\\cagr_full_set.pak'
		heap = BottomUpHeap}
	UnloadPak \{'pak\\cagr\\cagr_bink_set.pak'
		heap = heap_bink}
	if ScreenElementExists \{id = band_name_text}
		DestroyScreenElement \{id = band_name_text}
	endif
	if ScreenElementExists \{id = menu_backdrop_container}
		DestroyScreenElement \{id = menu_backdrop_container}
	endif
	if ScreenElementExists \{id = menu_backdrop}
		DestroyScreenElement \{id = menu_backdrop}
	endif
	if ScreenElementExists \{id = cagr_edit_vmenu}
		DestroyScreenElement \{id = cagr_edit_vmenu}
	endif
	if ScreenElementExists \{id = image_preview}
		DestroyScreenElement \{id = image_preview}
	endif
	destroy_generic_menu
	generic_ui_destroy
endscript

script CAGR_assets_startup 
	LoadTexture \{qs(0xec9ab695)}
	LoadTexture \{qs(0xea96c06b)}
	LoadTexture \{qs(0x09b38877)}
	CAGR_assets_load_texture_array \{load = 1}
endscript

script CAGR_assets_load_texture_array 
	<textures> = edit_graphics_backgrounds
	<textures> = (<textures> + edit_graphics_primitives)
	<textures> = (<textures> + edit_graphics_graphics)
	<textures> = (<textures> + edit_graphics_illustrations)
	<textures> = (<textures> + edit_graphics_premade)
	GetArraySize <textures>
	index = 0
	begin
	LoadTexture (<textures> [<index>])
	index = (<index> + 1)
	repeat <array_size>
endscript

script edit_graphic_select_random_logo 
	edit_graphic_clear_all
	GetArraySize ($edit_graphic_premade_graphics)
	if ((<array_size>) <= 0)
		printf \{'No pre-made graphics available!'}
		return
	endif
	GetRandomValue name = rand_index a = 0 b = (<array_size> -1) Integer
	random_entry = (($edit_graphic_premade_graphics) [<rand_index>])
	printstruct <random_entry>
	change edit_graphic_layer_infos = <random_entry>
endscript
