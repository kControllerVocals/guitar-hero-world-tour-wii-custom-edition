script edit_graphic_erase_layer 
	edit_graphic_erase_layer_dialog_exit
	edit_graphic_destroy_image_string
	edit_graphic_change_layer_info_value {change_texture_id = none
		change_texture_name = qs("")
		change_string = qs("")
		change_pos_x = (64)
		change_pos_y = (64)
		change_rot = 0
		change_scale_x = 1.0
		change_scale_y = 1.0
		change_flip_h = 0
		change_flip_v = 0
		change_h = 0
		change_s = 0
		change_v = 60
		change_a = 255
		change_color = none
		change_shear = 0.0
		change_skew = 0.0
	}
	edit_graphic_update_layer_graphics \{update_all = 0
		index = $EG_current_layer_menu_index}
	LaunchEvent \{type = pad_up
		target = edit_graphic_tool_vmenu}
	edit_graphic_highlight_avail_tools \{tools_in_focus = 1
		menu_index = $EG_current_layer_menu_index
		layer_index = $EG_current_layer_info_index}
endscript

